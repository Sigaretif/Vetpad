{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "vitest5",
  "plugins": ["@stryker-mutator/vitest-runner", "./scripts/stryker-vitest5-runner.mjs"],
  "mutate": ["src/lib/**/*.ts", "src/pages/api/**/*.ts"],
  "ignorePatterns": [
    ".claude",
    ".agents",
    ".github",
    ".husky",
    ".vscode",
    "dist",
    ".astro",
    ".wrangler",
    ".env",
    ".dev.vars",
    "context",
    "supabase",
    "public",
    "reports"
  ],
  "reporters": ["progress", "clear-text", "html"],
  "concurrency": 4,
  "thresholds": { "high": 80, "low": 60, "break": null }
}
