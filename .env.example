SUPABASE_URL=###
SUPABASE_KEY=###
# Model provider key for the AI audit (Anthropic). Left empty, the audit is switched off and the app says so.
ANTHROPIC_API_KEY=
# Apify API token for the fallback fetch of otodom.pl listings. Left empty, listings are fetched directly only and the app says so.
APIFY_TOKEN=
# Google Maps key for the Routes API, read by the Worker only, to compute commute times from an offer to the team's points. Left empty, commute times are switched off and the app says so. Never goes to CI.
GOOGLE_MAPS_SERVER_KEY=
# Google Maps key for the Maps JavaScript API, handed to the map on an offer's card after a calculation; restrict it by referrer in Google Cloud. Left empty, the commute table shows without a map and the app says so. Never goes to CI.
GOOGLE_MAPS_BROWSER_KEY=
# E2E test user for Playwright (local Supabase only; see context/foundation/test-stack.md)
E2E_USERNAME=
E2E_PASSWORD=
