---
import { cn } from "@/lib/utils";

type Variant = "info" | "warning" | "error";

interface Props {
  variant?: Variant;
}

const { variant = "info" } = Astro.props;

const variantClasses: Record<Variant, string> = {
  info: "bg-info text-info-foreground border-info-foreground/30",
  warning: "bg-warning text-warning-foreground border-warning-foreground/30",
  error: "bg-destructive/15 text-destructive border-destructive/40",
};
---

<div
  class:list={cn("banner border-b px-4 py-3 text-center text-sm", variantClasses[variant])}
  role={variant === "error" ? "alert" : "status"}
>
  <slot />
</div>

<style>
  .banner :global(a) {
    color: inherit;
    text-decoration: underline;
    font-weight: 600;
  }
  /* The same ring as buttonVariants (ring/50, 3px); >=3:1 on all three banner surfaces. */
  .banner :global(a:focus-visible) {
    outline: 3px solid color-mix(in oklab, var(--ring) 50%, transparent);
    outline-offset: 2px;
    border-radius: 2px;
  }
</style>
