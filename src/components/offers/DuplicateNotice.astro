---
import Banner from "@/components/Banner.astro";
import { saverName, type Saver } from "@/lib/members";

/*
 * The duplicate-offer notice (FR-005): the offer was already saved, and by whom. One component,
 * so the card page and the /dev/offer-card kitchen sink render the same production text. The
 * parent places it in AppLayout's `notice` slot. `unknown` names nobody — a failed read is
 * never reported as a deleted account.
 */
interface Props {
  saver: Saver;
}

const { saver } = Astro.props;

const who = saverName(saver);
---

<Banner variant="info">
  {who === null ? (
    "Ta oferta była już zapisana — otwieramy istniejącą kartę."
  ) : (
    <>
      Ta oferta była już zapisana przez <span class="wrap-anywhere">{who}</span> — otwieramy istniejącą kartę.
    </>
  )}
</Banner>
