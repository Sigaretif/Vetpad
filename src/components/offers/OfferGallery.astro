---
import { Card, CardContent, CardHeader } from "@/components/ui/card";
import Unstated from "@/components/offers/Unstated.astro";
import type { OfferImage } from "@/lib/otodom/types";
import { safeHttpsUrl } from "@/lib/safe-url";
import { cn } from "@/lib/utils";

interface Props {
  images: OfferImage[];
  title: string;
}

const { title } = Astro.props;
// Row data lands in href/src, so only entries whose both URLs are https: are rendered.
const images = Astro.props.images.flatMap((image) => {
  const thumbnail = safeHttpsUrl(image.thumbnail);
  const large = safeHttpsUrl(image.large);
  return thumbnail !== null && large !== null ? [{ thumbnail, large }] : [];
});
const total = images.length;
---

<section>
  <Card>
    <CardHeader>
      <h2 class="text-xl font-semibold">Zdjęcia</h2>
    </CardHeader>
    <CardContent>
      {total === 0 ? (
        <p class="text-sm">
          <Unstated>Ogłoszenie nie zawiera zdjęć.</Unstated>
        </p>
      ) : (
        <ul class:list={cn("grid gap-3", total === 1 ? "grid-cols-1" : "grid-cols-2 sm:grid-cols-3")}>
          {images.map((image, index) => (
            <li>
              <a
                href={image.large}
                target="_blank"
                rel="noopener noreferrer"
                class="border-border focus-visible:ring-ring/50 block overflow-hidden rounded-lg border transition-[opacity,box-shadow] outline-none hover:opacity-80 focus-visible:ring-[3px]"
              >
                <img
                  src={image.thumbnail}
                  alt={`Zdjęcie ${index + 1} z ${total}: ${title}`}
                  loading="lazy"
                  decoding="async"
                  referrerpolicy="no-referrer"
                  class="aspect-[4/3] w-full object-cover"
                />
              </a>
            </li>
          ))}
        </ul>
      )}
    </CardContent>
  </Card>
</section>
