---
import { Card, CardContent, CardHeader } from "@/components/ui/card";
import OfferPhotoViewer from "@/components/offers/OfferPhotoViewer";
import Unstated from "@/components/offers/Unstated.astro";
import { galleryPhotos } from "@/lib/offer-gallery";

interface Props {
  /** The stored column as read: any member can PATCH it, so an element may be anything. */
  images: unknown[];
  title: string;
  /** For the /dev kitchen sinks alone: the photo viewer is open on this photo (0-based). */
  openAt?: number;
}

const { title, openAt } = Astro.props;
// Row data lands in href/src/srcset and in the island's props, so only `galleryPhotos` results
// reach the island — never the column: an entry whose thumbnail or large photo is not https is
// skipped (the thumbnail still gates it, although the grid shows medium/large, so the card has the
// same photos as the board and the archive), and an element that is not an object is skipped the
// same way rather than failing the whole card.
const photos = galleryPhotos(Astro.props.images);
---

<section>
  <Card>
    <CardHeader>
      <h2 class="text-xl font-semibold">Zdjęcia</h2>
    </CardHeader>
    <CardContent>
      {photos.length === 0 ? (
        <p class="text-sm">
          <Unstated>Ogłoszenie nie zawiera zdjęć.</Unstated>
        </p>
      ) : (
        <OfferPhotoViewer client:load photos={photos} title={title} openAt={openAt} />
      )}
    </CardContent>
  </Card>
</section>
