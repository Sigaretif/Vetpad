---
import { Card, CardContent, CardHeader } from "@/components/ui/card";

interface Props {
  description: string;
}

const { description } = Astro.props;
---

<section>
  <Card>
    <CardHeader>
      <h2 class="text-xl font-semibold">Opis</h2>
    </CardHeader>
    <CardContent>
      <!-- Plain text stored without markup; rendered as text so nothing in it is interpreted as HTML. -->
      <p class="text-sm leading-relaxed wrap-break-word whitespace-pre-line">{description}</p>
    </CardContent>
  </Card>
</section>
