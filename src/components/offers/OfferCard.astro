---
import { TriangleAlert } from "lucide-react";
import { Alert, AlertDescription } from "@/components/ui/alert";
import { buttonVariants } from "@/components/ui/button";
import { Card, CardContent } from "@/components/ui/card";
import OfferDescription from "@/components/offers/OfferDescription.astro";
import OfferGallery from "@/components/offers/OfferGallery.astro";
import OfferParameters from "@/components/offers/OfferParameters.astro";
import RefetchForm from "@/components/offers/RefetchForm";
import Unstated from "@/components/offers/Unstated.astro";
import { saverName, type Saver } from "@/lib/members";
import { formatClock, formatTimestamp } from "@/lib/format";
import { mapSearchUrl } from "@/lib/map-link";
import { LOST_FACT_LABELS, readLostTokens } from "@/lib/offer-refetch";
import { formatMoney } from "@/lib/otodom/labels";
import type { OfferRow } from "@/lib/otodom/types";
import { safeHttpsUrl } from "@/lib/safe-url";
import { cn } from "@/lib/utils";

interface Props {
  offer: OfferRow;
  /** Who saved the offer, resolved once per view (`resolveSaver` in `@/lib/members`). */
  saver: Saver;
  /** A failed re-fetch, from the card's `?error=…&form=refetch` — shown in the re-fetch block, as text. */
  refetchError?: string | null;
  /**
   * The card's `?lost=` as the address carries it: the columns a re-fetch stopped on. Anyone can
   * type it by hand, so it is read here through `readLostTokens` and only the columns it names
   * that the audit reads are shown, by their names from code — never the value itself.
   */
  lost?: string | null;
  /** The re-fetch block's id: the route redirects to `#pobranie`; the kitchen sink passes unique values. */
  refetchAnchorId?: string;
}

const { offer, saver, refetchError = null, lost = null, refetchAnchorId = "pobranie" } = Astro.props;

// A re-fetch that stopped on facts the stored listing states and the fetched one does not
// (`@/lib/offer-refetch`). Empty — no `lost`, or nothing in it that names a column — is a plain
// re-fetch block with no warning.
const lostColumns = lost === null ? [] : readLostTokens(lost);

const who = saverName(saver);
const savedOn = formatTimestamp(offer.created_at);

/** `null` stays "not stated"; only a stated amount is formatted. */
function money(amount: number | null, currency: string | null, suffix = ""): string | null {
  return amount === null ? null : `${formatMoney(amount, currency)}${suffix}`;
}

const images = Array.isArray(offer.images) ? offer.images : [];
const price = money(offer.price, offer.price_currency);
const pricePerM = money(offer.price_per_m, offer.price_currency, "/m²");
const sourceUrl = safeHttpsUrl(offer.source_url);
// `null` when the offer states no location: the card then renders no map link.
const mapUrl = mapSearchUrl(offer);
const linkClass = cn(buttonVariants({ variant: "link" }), "h-auto p-0");
---

<header>
  <Card>
    <CardContent>
      <h1 class="mb-3 text-2xl font-bold wrap-anywhere sm:text-3xl">{offer.title}</h1>
      <div class="flex flex-wrap items-baseline gap-x-6 gap-y-1">
        <p class="text-2xl font-semibold">{price ?? <Unstated>Cena: nie podano w ogłoszeniu</Unstated>}</p>
        <p class="text-muted-foreground">{pricePerM ?? <Unstated>Cena za m²: nie podano w ogłoszeniu</Unstated>}</p>
      </div>
      <p class="text-muted-foreground mt-2">
        {offer.location_label ?? <Unstated>Lokalizacja: nie podano w ogłoszeniu</Unstated>}
      </p>
      <p class="text-muted-foreground mt-1 text-sm">
        {who === null ? (
          `Zapisane ${savedOn}`
        ) : (
          <>
            Zapisane przez <span class="wrap-anywhere">{who}</span> · {savedOn}
          </>
        )}
      </p>
      {(sourceUrl ?? mapUrl) && (
        <div class="mt-4 flex flex-wrap gap-x-6 gap-y-2">
          {sourceUrl && (
            <a href={sourceUrl} target="_blank" rel="noopener noreferrer" class:list={linkClass}>
              Otwórz oryginał na otodom.pl ↗
            </a>
          )}
          {mapUrl && (
            <a href={mapUrl} target="_blank" rel="noopener noreferrer" class:list={linkClass}>
              Pokaż na mapie Google ↗
            </a>
          )}
        </div>
      )}
      <div
        id={refetchAnchorId}
        data-refetch-state={lostColumns.length > 0 ? "lost" : "default"}
        class="border-border mt-4 flex scroll-mt-4 flex-col gap-3 border-t pt-4"
      >
        <p class="text-muted-foreground text-sm">
          Dane ogłoszenia pobrano z otodom.pl:{" "}
          <time datetime={offer.fetched_at} class="text-foreground wrap-anywhere">
            {formatTimestamp(offer.fetched_at)}, {formatClock(offer.fetched_at)}
          </time>
        </p>
        {lostColumns.length > 0 && (
          <Alert role="status" className="border-warning-foreground/30 bg-warning text-warning-foreground">
            <TriangleAlert />
            <AlertDescription className="text-warning-foreground">
              <p>
                Nic nie zostało zapisane. Ogłoszenie pobrane teraz z otodom.pl nie podaje pól, które zapisane ogłoszenie
                podaje:
              </p>
              <ul class="list-disc pl-5">
                {lostColumns.map((column) => (
                  <li>{LOST_FACT_LABELS[column]}</li>
                ))}
              </ul>
              <p>
                Jeśli nadpiszesz zapisane dane, te informacje znikną z karty. Ogłoszenie zostanie pobrane jeszcze raz.
              </p>
            </AlertDescription>
          </Alert>
        )}
        <RefetchForm client:load offerId={offer.id} serverError={refetchError} acceptLost={lostColumns.join(",")} />
      </div>
    </CardContent>
  </Card>
</header>

<OfferParameters offer={offer} />
<OfferDescription description={offer.description} />
<OfferGallery images={images} title={offer.title} />
