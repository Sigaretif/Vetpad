---
import type { AuditRunnerPreview } from "@/components/offers/AuditRunner";
import type { CommutePreview } from "@/components/offers/CommuteRunner";
import OfferAudit from "@/components/offers/OfferAudit.astro";
import OfferCommute from "@/components/offers/OfferCommute.astro";
import OfferCard from "@/components/offers/OfferCard.astro";
import OfferNotes from "@/components/offers/OfferNotes.astro";
import type { AuditFreshness } from "@/lib/audit/freshness";
import type { OfferAudit as OfferAuditData } from "@/lib/audit/store";
import type { CommuteOrigin } from "@/lib/commute/origin";
import type { CommutePointsResult } from "@/lib/commute/points";
import type { Saver } from "@/lib/members";
import { archiveOf, type OfferArchiveState } from "@/lib/offer-archive";
import type { OfferNotes as OfferNotesData } from "@/lib/notes";
import type { OfferRow } from "@/lib/otodom/types";

/*
 * The offer card beside the team column: two columns from `lg` up, stacked below it (the listing
 * first, then the team column). The team column holds the AI audit, under it the notes, and under
 * them the commute times (FR-016): reads of their own, so each renders whatever the others' did.
 * One component for the card page and the /dev/offer-card kitchen sink; the page renders it inside
 * `<AppLayout wide>`.
 *
 * `data-offer-archived` carries whether the offer is in the archive (FR-014) into the markup, where
 * scripts/smoke.mjs reads it. It is the row's fact — `archived_at` — and never anything the address
 * said; the `archive` prop only adds who archived the offer. The card shows the state and holds the
 * form that changes it, and the audit and commute sections get it as `archived`, because an
 * archived offer's audit cannot be started and its commute cannot be calculated.
 */
interface Props {
  offer: OfferRow;
  saver: Saver;
  notes: OfferNotesData;
  /** The offer's audit as `loadOfferAudit` read it; a failed read is its own state. */
  audit: OfferAuditData;
  /** Whether the application holds a model-provider key (`isAuditAvailable`). */
  auditAvailable: boolean;
  /**
   * Whether the audit's stored result still describes the listing and the criteria
   * (`auditFreshness`); `null` when there is no result to judge.
   */
  freshness: AuditFreshness | null;
  noteError?: string | null;
  /** Passed to OfferCard: a failed re-fetch from the card's `?error=…&form=refetch`. */
  refetchError?: string | null;
  /** Passed to OfferCard: the card's `?lost=`, as the address carries it. */
  lost?: string | null;
  startEditing?: boolean;
  /** Passed to OfferNotes as `anchorId`; unique per instance on the kitchen sink. */
  notesAnchorId?: string;
  /** Passed to OfferAudit as `anchorId`; unique per instance on the kitchen sink. */
  auditAnchorId?: string;
  /** Passed to OfferCard as `refetchAnchorId`; unique per instance on the kitchen sink. */
  refetchAnchorId?: string;
  /** A state the audit island opens in — for the kitchen sink only. */
  auditRunnerPreview?: AuditRunnerPreview;
  /** The offer's archive state with its archiver named; left out, an archived offer names nobody. */
  archive?: OfferArchiveState | null;
  /** Passed to OfferCard: a failed archiving or restore from the card's `?error=…&form=archive`. */
  archiveError?: string | null;
  /** Passed to OfferCard as `archiveAnchorId`; unique per instance on the kitchen sink. */
  archiveAnchorId?: string;
  /** Passed to OfferCard: a failed deletion of the offer from the card's `?error=…&form=delete`. */
  deleteError?: string | null;
  /** Passed to OfferCard as `deleteAnchorId`; unique per instance on the kitchen sink. */
  deleteAnchorId?: string;
  /** Passed to OfferNotes: a failed deletion of the member's own note, from `?error=…&form=note-delete`. */
  noteDeleteError?: string | null;
  /** The team's commute points as `loadCommutePoints` read them; a failed read is its own state. */
  commutePoints: CommutePointsResult;
  /** The kind of start `commuteOrigin` gives for the offer, or `null` when it has none. */
  commuteOrigin: CommuteOrigin["kind"] | null;
  /** Whether the application holds the Routes key (`isCommuteAvailable`). */
  commuteAvailable: boolean;
  /** The browser key for the map (`commuteMapKey`), or `null`; only the card page passes one. */
  commuteMapKey: string | null;
  /** Passed to OfferCommute as `anchorId`; unique per instance on the kitchen sink. */
  commuteAnchorId?: string;
  /** A state the commute island opens in — for the kitchen sink only. */
  commuteRunnerPreview?: CommutePreview;
}

const {
  offer,
  saver,
  notes,
  audit,
  auditAvailable,
  freshness,
  noteError = null,
  refetchError = null,
  lost = null,
  startEditing = false,
  notesAnchorId,
  auditAnchorId,
  refetchAnchorId,
  auditRunnerPreview,
  archive,
  archiveError = null,
  archiveAnchorId,
  deleteError = null,
  deleteAnchorId,
  noteDeleteError = null,
  commutePoints,
  commuteOrigin,
  commuteAvailable,
  commuteMapKey,
  commuteAnchorId,
  commuteRunnerPreview,
} = Astro.props;

const archived = archive ?? archiveOf(offer, { kind: "unknown" });
---

<div
  data-offer-archived={archived === null ? "false" : "true"}
  class="grid gap-6 lg:grid-cols-[minmax(0,1fr)_minmax(0,24rem)] lg:items-start"
>
  <div class="flex min-w-0 flex-col gap-6">
    <OfferCard
      offer={offer}
      saver={saver}
      refetchError={refetchError}
      lost={lost}
      refetchAnchorId={refetchAnchorId}
      archive={archived}
      archiveError={archiveError}
      archiveAnchorId={archiveAnchorId}
      deleteError={deleteError}
      deleteAnchorId={deleteAnchorId}
    />
  </div>
  <div class="flex min-w-0 flex-col gap-8">
    <OfferAudit
      offerId={offer.id}
      audit={audit}
      available={auditAvailable}
      freshness={freshness}
      archived={archived !== null}
      anchorId={auditAnchorId}
      runnerPreview={auditRunnerPreview}
    />
    <OfferNotes
      offerId={offer.id}
      notes={notes}
      serverError={noteError}
      deleteError={noteDeleteError}
      startEditing={startEditing}
      anchorId={notesAnchorId}
    />
    <OfferCommute
      offerId={offer.id}
      points={commutePoints}
      origin={commuteOrigin}
      available={commuteAvailable}
      mapKey={commuteMapKey}
      archived={archived !== null}
      anchorId={commuteAnchorId}
      runnerPreview={commuteRunnerPreview}
    />
  </div>
</div>
