---
import { buttonVariants } from "@/components/ui/button";
---

<div class="flex flex-col items-center justify-center px-4 py-24 text-center sm:py-32 lg:py-40">
  <h1 class="text-foreground mb-6 text-5xl leading-tight font-bold sm:text-6xl lg:text-7xl">Vetpad</h1>
  <p class="text-muted-foreground mb-10 max-w-2xl text-lg sm:text-xl">
    Wspólna tablica zespołu do sprawdzania ogłoszeń mieszkań: zapisujecie ofertę z otodom.pl, zlecacie jej audyt i
    dopisujecie notatki.
  </p>
  <a href="/auth/signin" class:list={buttonVariants({ size: "lg" })}>
    Zaloguj
  </a>
</div>
