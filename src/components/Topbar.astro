---
import { buttonVariants } from "@/components/ui/button";
import { cn } from "@/lib/utils";

const { user } = Astro.locals;
// Text links: the link variant without the default size's height and padding.
const link = cn(buttonVariants({ variant: "link" }), "h-auto p-0");
---

<header class="bg-card text-card-foreground border-border rounded-xl border px-4 py-2 text-sm">
  <nav aria-label="Konto" class="flex items-center justify-between gap-4">
    {user ? (
      <>
        <span class="text-muted-foreground">{user.email}</span>
        <div class="flex items-center gap-3">
          <a href="/dashboard" class:list={link}>
            Oferty
          </a>
          <form method="POST" action="/api/auth/signout">
            <button type="submit" class:list={link}>
              Wyloguj
            </button>
          </form>
        </div>
      </>
    ) : (
      <>
        <span class="text-muted-foreground">Nie zalogowano</span>
        <a href="/auth/signin" class:list={link}>
          Zaloguj
        </a>
      </>
    )}
  </nav>
</header>
