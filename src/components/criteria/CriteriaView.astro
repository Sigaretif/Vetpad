---
import { CircleAlert, Info } from "lucide-react";
import { Alert, AlertDescription } from "@/components/ui/alert";
import { Card, CardContent, CardDescription, CardHeader } from "@/components/ui/card";
import { ServerError } from "@/components/form/ServerError";
import AuditSettingsForm from "@/components/criteria/AuditSettingsForm";
import CommutePointsEditor from "@/components/criteria/CommutePointsEditor";
import { RequirementsCard } from "@/components/criteria/RequirementsCard";
import RequirementsEditor from "@/components/criteria/RequirementsEditor";
import TeamLimitsForm from "@/components/criteria/TeamLimitsForm";
import { AUDIT_EFFORT_LABELS, AUDIT_MODEL_LABELS, type AuditSettingsResult } from "@/lib/audit/settings";
import type { CommutePointsResult } from "@/lib/commute/points";
import type { CriteriaResult } from "@/lib/criteria";
import { INGESTION_MODE_LABELS, type ResolvedIngestionMode } from "@/lib/ingestion-settings";
import { formatTimestamp } from "@/lib/format";
import { saverName } from "@/lib/members";
import { formatArea, formatMoney } from "@/lib/otodom/labels";

/*
 * The team's search criteria (FR-002, FR-003): the shared limits with who last changed them and
 * the form that edits them, then the member's own requirements in the editor island and everyone
 * else's, rendered without a client directive. Below them, the team's audit settings (FR-010):
 * the model and the reasoning effort the next AI audit runs with, who last changed them, and the
 * form that changes them. One component for /criteria and the /dev/criteria kitchen sink.
 *
 * A failed read is never "no limits": the view then renders no form, because a form prefilled
 * from it would overwrite the team's row with blanks. `data-criteria-state` carries ok or error
 * into the markup, where scripts/smoke.mjs can check it — a 200 alone cannot tell them apart.
 *
 * The audit settings are a read of their own, so their section renders whatever the criteria
 * read did, and carries its own `data-audit-settings-state`. A failed settings read is never
 * shown as the defaults, and renders no form either. With a successful one the section also
 * carries the stored values as `data-audit-model` and `data-audit-effort`, for the same script.
 *
 * The team's commute points (FR-016) are a read of their own as well: the section lists every point
 * with its edit and delete actions and the form that adds one, and carries
 * `data-commute-points-state`. A failed read is never "no points": it renders no form, because the
 * add form would offer a seventh point to a team that may already have six, and an empty list would
 * say the team has none. `?point=gone` from `POST /api/commute-points` picks a sentence through a
 * whitelist and is never rendered itself.
 *
 * Last, the ingestion mode (FR-004, FR-009), read-only: the owner changes it in Supabase, so the
 * section has no form. It carries its read as `data-ingestion-settings-state`, the configured mode
 * as `data-ingestion-mode` (only after a successful read) and the mode that actually runs as
 * `data-ingestion-mode-effective` — none of the three stands in for another. A failed read is
 * never shown as a mode: it names none and says the listings are fetched directly only, which is
 * what `resolveIngestionMode` runs it as.
 */
interface Props {
  criteria: CriteriaResult;
  auditSettings: AuditSettingsResult;
  commutePoints: CommutePointsResult;
  /** The configured and the effective ingestion mode, from `resolveIngestionMode`. */
  ingestion: ResolvedIngestionMode;
  /** The page's `?error=`, and which form it belongs to (`?form=`); `null` when none is named. */
  serverError?: string | null;
  serverErrorFor?: "limits" | "requirements" | "audit" | "points" | null;
  /** The page's `?point=`, as the address carries it: only `gone` renders anything. */
  pointResult?: string | null;
  startEditing?: boolean;
  /** For the /dev kitchen sinks alone: the point whose edit form is open on the first render. */
  editingPointId?: string | null;
  /** Appended to the sections' ids (`#limity`/`#wymagania`/`#punkty`/`#audyt`/`#pobieranie`): the routes redirect to the first four; the kitchen sink passes unique values. */
  anchorSuffix?: string;
}

const {
  criteria,
  auditSettings,
  commutePoints,
  ingestion,
  serverError = null,
  serverErrorFor = null,
  pointResult = null,
  startEditing = false,
  editingPointId = null,
  anchorSuffix = "",
} = Astro.props;

const limitsId = `limity${anchorSuffix}`;
const requirementsId = `wymagania${anchorSuffix}`;
const pointsId = `punkty${anchorSuffix}`;
const auditId = `audyt${anchorSuffix}`;
const ingestionId = `pobieranie${anchorSuffix}`;
const limitsError = serverErrorFor === "limits" ? serverError : null;
const requirementsError = serverErrorFor === "requirements" ? serverError : null;
// The audit and the points sections render in every state of the view, so their messages are always shown there.
const auditError = serverErrorFor === "audit" ? serverError : null;
const pointsError = serverErrorFor === "points" ? serverError : null;
// A message that names no form is still shown once, above the criteria forms, rather than lost.
const unattributedError = serverErrorFor === null ? serverError : null;
// With the criteria unread neither criteria form renders, so their messages are shown above the alert.
const criteriaError = serverErrorFor === "audit" || serverErrorFor === "points" ? null : serverError;

// What a deletion of a point ended with, from `?point=`, which anyone can type by hand: the value only
// picks a sentence, and a value that is not on the list renders nothing.
const POINT_RESULTS = { gone: "Tego punktu już nie było — niczego nie usunięto." };
const pointNotice =
  pointResult !== null && Object.hasOwn(POINT_RESULTS, pointResult)
    ? (pointResult as keyof typeof POINT_RESULTS)
    : null;

const NO_LIMIT = "bez limitu";

const limitRows =
  criteria.state === "ok"
    ? [
        { label: "Miasto", value: criteria.limits.city },
        {
          label: "Cena od",
          value: criteria.limits.priceMin === null ? null : formatMoney(criteria.limits.priceMin, "PLN"),
        },
        {
          label: "Cena do",
          value: criteria.limits.priceMax === null ? null : formatMoney(criteria.limits.priceMax, "PLN"),
        },
        {
          label: "Minimalny metraż",
          value: criteria.limits.areaMin === null ? null : formatArea(criteria.limits.areaMin),
        },
      ]
    : [];

// „przez" takes the accusative saverName gives („Ciebie", „osobę z usuniętym kontem"); an author
// we could not establish is not named at all, and limits never set carry no signature.
const changedAt = criteria.state === "ok" ? criteria.limitsChangedAt : null;
const changedBy = criteria.state === "ok" && criteria.limitsChangedBy ? saverName(criteria.limitsChangedBy) : null;

const settingRows =
  auditSettings.state === "ok"
    ? [
        { label: "Model", value: AUDIT_MODEL_LABELS[auditSettings.model] },
        { label: "Poziom rozumowania", value: AUDIT_EFFORT_LABELS[auditSettings.effort] },
      ]
    : [];

// The same rule as for the limits: settings never changed carry no signature, and a member we
// could not establish is not named.
const settingsChangedAt = auditSettings.state === "ok" ? auditSettings.changedAt : null;
const settingsChangedBy =
  auditSettings.state === "ok" && auditSettings.changedBy ? saverName(auditSettings.changedBy) : null;

// `configured` is null exactly when the mode could not be read (`resolveIngestionMode`).
const ingestionConfigured = ingestion.configured;
const ingestionState = ingestionConfigured === null ? "error" : "ok";

const sectionClass = "flex scroll-mt-4 flex-col gap-4";
const labelClass = "text-muted-foreground mb-1 text-xs font-medium tracking-wide uppercase";
---

<div data-criteria-state={criteria.state} class="flex flex-col gap-8">
  {criteria.state === "ok" ? (
    <>
      <ServerError message={unattributedError} />

      <section
        id={limitsId}
        aria-labelledby={`${limitsId}-naglowek`}
        data-criteria-section="limits"
        class:list={sectionClass}
      >
        <div class="flex flex-col gap-1">
          <h2 id={`${limitsId}-naglowek`} class="text-xl font-semibold">
            Limity zespołu
          </h2>
          <p class="text-muted-foreground text-sm">Wspólne dla całego zespołu — każdy członek może je zmienić.</p>
        </div>

        <div class="grid gap-4 md:grid-cols-2 md:items-start">
          <Card className="gap-4">
            <CardHeader>
              <h3 class="leading-snug font-semibold">Obowiązujące limity</h3>
              {changedAt !== null && (
                <CardDescription>
                  Ostatnio zmienione {changedBy !== null && <span class="wrap-anywhere">przez {changedBy},</span>}{" "}
                  <time datetime={changedAt}>{formatTimestamp(changedAt)}</time>
                </CardDescription>
              )}
            </CardHeader>
            <CardContent>
              <dl class="flex flex-col gap-3 text-sm">
                {limitRows.map((row) => (
                  <div>
                    <dt class:list={labelClass}>{row.label}</dt>
                    <dd class="wrap-anywhere">{row.value ?? <span class="text-muted-foreground">{NO_LIMIT}</span>}</dd>
                  </div>
                ))}
              </dl>
            </CardContent>
          </Card>

          <Card className="gap-4">
            <CardHeader>
              <h3 class="leading-snug font-semibold">Zmień limity</h3>
            </CardHeader>
            <CardContent>
              <TeamLimitsForm client:load limits={criteria.limits} serverError={limitsError} />
            </CardContent>
          </Card>
        </div>
      </section>

      <section
        id={requirementsId}
        aria-labelledby={`${requirementsId}-naglowek`}
        data-criteria-section="requirements"
        class:list={sectionClass}
      >
        <div class="flex flex-col gap-1">
          <h2 id={`${requirementsId}-naglowek`} class="text-xl font-semibold">
            Wymagania dodatkowe
          </h2>
          <p class="text-muted-foreground text-sm">
            Każdy członek pisze własne — czytają je wszyscy, zmienić może tylko autor.
          </p>
        </div>

        <RequirementsEditor
          client:load
          own={criteria.own}
          serverError={requirementsError}
          startEditing={startEditing}
        />

        <h3 class="text-lg font-semibold">Wymagania pozostałych członków</h3>
        {criteria.others.length > 0 ? (
          criteria.others.map((requirements) => (
            <RequirementsCard
              author={requirements.author}
              body={requirements.body}
              updatedAt={requirements.updatedAt}
              headingLevel={4}
            />
          ))
        ) : (
          <p class="text-muted-foreground text-sm">Nikt inny nie wpisał jeszcze wymagań.</p>
        )}
      </section>
    </>
  ) : (
    <>
      {/* A failed save that landed on a failed read: the member still has to learn the save did not happen. */}
      <ServerError message={criteriaError} />
      <Alert variant="destructive">
        <CircleAlert />
        <AlertDescription>Nie udało się wczytać kryteriów.</AlertDescription>
      </Alert>
    </>
  )}

  <section
    id={pointsId}
    aria-labelledby={`${pointsId}-naglowek`}
    data-criteria-section="points"
    data-commute-points-state={commutePoints.state}
    class:list={sectionClass}
  >
    <div class="flex flex-col gap-1">
      <h2 id={`${pointsId}-naglowek`} class="text-xl font-semibold">
        Punkty dojazdu
      </h2>
      <p class="text-muted-foreground text-sm">
        Miejsca, do których zespół liczy czas dojazdu z oferty na jej karcie. Wspólne dla całego zespołu — każdy członek
        może je dodać, zmienić i usunąć.
      </p>
    </div>

    {pointNotice !== null && (
      <Alert>
        <Info />
        <AlertDescription data-point-result={pointNotice}>{POINT_RESULTS[pointNotice]}</AlertDescription>
      </Alert>
    )}

    {commutePoints.state === "ok" ? (
      <CommutePointsEditor
        client:load
        points={commutePoints.points}
        serverError={pointsError}
        editingId={editingPointId}
      />
    ) : (
      <>
        {/* As for the criteria: a failed save that landed on a failed read is still reported. */}
        <ServerError message={pointsError} />
        <Alert variant="destructive">
          <CircleAlert />
          <AlertDescription>Nie udało się wczytać punktów dojazdu.</AlertDescription>
        </Alert>
      </>
    )}
  </section>

  <section
    id={auditId}
    aria-labelledby={`${auditId}-naglowek`}
    data-criteria-section="audit"
    data-audit-settings-state={auditSettings.state}
    data-audit-model={auditSettings.state === "ok" ? auditSettings.model : undefined}
    data-audit-effort={auditSettings.state === "ok" ? auditSettings.effort : undefined}
    class:list={sectionClass}
  >
    <div class="flex flex-col gap-1">
      <h2 id={`${auditId}-naglowek`} class="text-xl font-semibold">
        Ustawienia audytu AI
      </h2>
      <p class="text-muted-foreground text-sm">
        Model i poziom rozumowania, z którymi wykonywany jest audyt AI ogłoszenia. Wspólne dla całego zespołu — każdy
        członek może je zmienić.
      </p>
    </div>

    {auditSettings.state === "ok" ? (
      <div class="grid gap-4 md:grid-cols-2 md:items-start">
        <Card className="gap-4">
          <CardHeader>
            <h3 class="leading-snug font-semibold">Obowiązujące ustawienia</h3>
            {settingsChangedAt !== null && (
              <CardDescription>
                Ostatnio zmienione{" "}
                {settingsChangedBy !== null && <span class="wrap-anywhere">przez {settingsChangedBy},</span>}{" "}
                <time datetime={settingsChangedAt}>{formatTimestamp(settingsChangedAt)}</time>
              </CardDescription>
            )}
          </CardHeader>
          <CardContent>
            <dl class="flex flex-col gap-3 text-sm">
              {settingRows.map((row) => (
                <div>
                  <dt class:list={labelClass}>{row.label}</dt>
                  <dd class="wrap-anywhere">
                    {row.value.name} <span class="text-muted-foreground">({row.value.hint})</span>
                  </dd>
                </div>
              ))}
            </dl>
          </CardContent>
        </Card>

        <Card className="gap-4">
          <CardHeader>
            <h3 class="leading-snug font-semibold">Zmień ustawienia</h3>
          </CardHeader>
          <CardContent>
            <AuditSettingsForm
              client:load
              settings={{ model: auditSettings.model, effort: auditSettings.effort }}
              serverError={auditError}
            />
          </CardContent>
        </Card>
      </div>
    ) : (
      <>
        {/* As for the criteria: a failed save that landed on a failed read is still reported. */}
        <ServerError message={auditError} />
        <Alert variant="destructive">
          <CircleAlert />
          <AlertDescription>Nie udało się wczytać ustawień audytu.</AlertDescription>
        </Alert>
      </>
    )}
  </section>

  <section
    id={ingestionId}
    aria-labelledby={`${ingestionId}-naglowek`}
    data-criteria-section="ingestion"
    data-ingestion-settings-state={ingestionState}
    data-ingestion-mode={ingestionConfigured ?? undefined}
    data-ingestion-mode-effective={ingestion.effective}
    class:list={sectionClass}
  >
    <div class="flex flex-col gap-1">
      <h2 id={`${ingestionId}-naglowek`} class="text-xl font-semibold">
        Pobieranie ogłoszeń
      </h2>
      <p class="text-muted-foreground text-sm">
        Sposób, w jaki aplikacja pobiera ogłoszenie z otodom.pl przy dodawaniu i odświeżaniu oferty. Tryb zmienia
        administrator bazy w Supabase.
      </p>
    </div>

    {ingestionConfigured !== null ? (
      <Card className="gap-4">
        <CardHeader>
          <h3 class="leading-snug font-semibold">Tryb pobierania</h3>
        </CardHeader>
        <CardContent className="flex flex-col gap-3">
          <dl class="flex flex-col gap-3 text-sm">
            <div>
              <dt class:list={labelClass}>Ustawiony tryb</dt>
              <dd class="wrap-anywhere">{INGESTION_MODE_LABELS[ingestionConfigured]}</dd>
            </div>
          </dl>
          {ingestion.reason === "apify_unconfigured" && (
            <p class="text-muted-foreground text-sm">
              Obecnie działa: {INGESTION_MODE_LABELS[ingestion.effective]} — brak klucza Apify
            </p>
          )}
        </CardContent>
      </Card>
    ) : (
      <Alert variant="destructive">
        <CircleAlert />
        <AlertDescription>
          Nie udało się odczytać trybu pobierania — aplikacja pobiera ogłoszenia tylko bezpośrednio.
        </AlertDescription>
      </Alert>
    )}
  </section>
</div>
