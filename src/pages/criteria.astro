---
import AppLayout from "@/layouts/AppLayout.astro";
import CriteriaView from "@/components/criteria/CriteriaView.astro";
import { loadAuditSettings } from "@/lib/audit/settings";
import { loadCommutePoints } from "@/lib/commute/points";
import { isApifyAvailable } from "@/lib/config-status";
import { loadCriteria } from "@/lib/criteria";
import { loadIngestionSettings, resolveIngestionMode } from "@/lib/ingestion-settings";
import { createClient } from "@/lib/supabase";

// `null` when Supabase is unconfigured: loadCriteria, loadAuditSettings, loadCommutePoints and
// loadIngestionSettings then answer `{ state: "error" }`, which renders the error states without
// forms — never a 500 (the zero-config rule). Four independent reads, sent together: none waits for
// another, and a failure of one does not hide what the others read.
const supabase = createClient(Astro.request.headers, Astro.cookies);
const viewerId = Astro.locals.user?.id;
const [criteria, auditSettings, commutePoints, ingestionSettings] = await Promise.all([
  loadCriteria(supabase, viewerId),
  loadAuditSettings(supabase, viewerId),
  loadCommutePoints(supabase),
  loadIngestionSettings(supabase),
]);
// The mode the routes would run, by the same rule they use. The page asks config-status whether a
// token is set and never imports the Apify module, which holds the token.
const ingestion = resolveIngestionMode(ingestionSettings, isApifyAvailable());

// POST /api/criteria, POST /api/requirements, POST /api/commute-points and POST /api/audit-settings
// redirect here with `?error=` and `&form=` naming the form it belongs to. Rendered as text, never as
// HTML. POST /api/commute-points also sends `?point=gone`, which the view reads through a whitelist.
const serverError = Astro.url.searchParams.get("error");
const form = Astro.url.searchParams.get("form");
const serverErrorFor =
  form === "limits" || form === "requirements" || form === "audit" || form === "points" ? form : null;
const pointResult = Astro.url.searchParams.get("point");
---

<AppLayout title="Kryteria — Vetpad">
  <h1 class="text-foreground text-2xl font-bold">Kryteria wyszukiwania</h1>

  <CriteriaView
    criteria={criteria}
    auditSettings={auditSettings}
    commutePoints={commutePoints}
    ingestion={ingestion}
    serverError={serverError}
    serverErrorFor={serverErrorFor}
    pointResult={pointResult}
  />
</AppLayout>
