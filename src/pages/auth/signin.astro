---
import Layout from "@/layouts/Layout.astro";
import SignInForm from "@/components/auth/SignInForm";
import { Card, CardContent } from "@/components/ui/card";

const error = Astro.url.searchParams.get("error");
---

<Layout title="Logowanie — Vetpad">
  <div class="flex min-h-screen items-center justify-center p-4">
    <Card className="w-full max-w-sm">
      <CardContent>
        <h1 class="text-foreground mb-6 text-center text-2xl font-bold">Zaloguj się</h1>
        <SignInForm serverError={error} client:load />
        <p class="text-muted-foreground mt-4 text-center text-sm">Konta zakłada administrator zespołu.</p>
      </CardContent>
    </Card>
  </div>
</Layout>
