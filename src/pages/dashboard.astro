---
import AppLayout from "@/layouts/AppLayout.astro";
import AddOfferForm from "@/components/offers/AddOfferForm";
import OfferBoard from "@/components/offers/OfferBoard.astro";
import RecentlyArchived from "@/components/offers/RecentlyArchived.astro";
import { Card, CardHeader, CardDescription, CardContent } from "@/components/ui/card";
import { loadBoardFreshness } from "@/lib/audit/freshness";
import { loadAuditIndex } from "@/lib/audit/store";
import { loadCriteriaRevision, loadTeamLimits } from "@/lib/criteria";
import { loadArchive } from "@/lib/offer-archive";
import { BOARD_COLUMNS, BOARD_SORT_COLUMN, parseBoardSort, type BoardResult, type BoardSort } from "@/lib/offer-board";
import { createClient } from "@/lib/supabase";

const error = Astro.url.searchParams.get("error");
const sort = parseBoardSort(Astro.url.searchParams);
const supabase = createClient(Astro.request.headers, Astro.cookies);

/**
 * Every live offer in the chosen order — an archived one is not on the board (FR-014) — or `{ ok: false }` for unconfigured Supabase (the
 * zero-config state), a query error or a thrown exception — each renders the board's error
 * state, never a 500 and never an empty board. `nullsFirst: false` holds in both directions:
 * an offer that does not state its price or area is always last (prd.md, Guardrails).
 */
async function loadBoard({ key, dir }: BoardSort): Promise<BoardResult> {
  if (!supabase) return { ok: false };
  try {
    const result = await supabase
      .from("offers")
      .select(BOARD_COLUMNS)
      .is("archived_at", null)
      .order(BOARD_SORT_COLUMN[key], { ascending: dir === "asc", nullsFirst: false })
      .order("id", { ascending: true });
    // The client is untyped, so `data` is already accepted as OfferBoardItem[] (BOARD_COLUMNS is that Pick).
    return result.error ? { ok: false } : { ok: true, offers: result.data };
  } catch {
    return { ok: false };
  }
}

// The team's limits, the index of audited offers and the criteria revision are read beside the
// offers, not after them, and so is the archive, for the section under the board; each of the five
// reads may fail on its own, and none of them throws. A failed read of the archive is that
// section's error state and changes nothing on the board.
const [board, limits, audits, revision, archive] = await Promise.all([
  loadBoard(sort),
  loadTeamLimits(supabase),
  loadAuditIndex(supabase),
  loadCriteriaRevision(supabase),
  loadArchive(supabase, Astro.locals.user?.id, new Date()),
]);

// Whether each stored result still describes the listing and the criteria (FR-003, FR-009). The
// read needs the index, so it comes after it: one query for the audited offers alone, none when
// there are none. It never throws, and a failure leaves the list as it is — the audited rows then
// say their freshness could not be established. A revision that could not be read goes in as
// `null`, and the rule decides. Nothing here runs, re-runs or removes an audit.
const freshness = await loadBoardFreshness(supabase, audits, revision.ok ? revision.revision : null);
---

<AppLayout title="Oferty — Vetpad">
  <h1 class="text-foreground text-2xl font-bold">Oferty</h1>

  <Card>
    <CardHeader>
      <h2 class="text-foreground text-xl font-semibold">Nowa oferta</h2>
      <CardDescription>Wklej adres ogłoszenia sprzedaży mieszkania z otodom.pl.</CardDescription>
    </CardHeader>
    <CardContent>
      <AddOfferForm serverError={error} client:load />
    </CardContent>
  </Card>

  <OfferBoard result={board} limits={limits} audits={audits} freshness={freshness} sort={sort} />

  <RecentlyArchived result={archive} />
</AppLayout>
