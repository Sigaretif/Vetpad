  caption: string;
  audit: OfferAuditData;
  available: boolean;
  /** Left out, a stored result reads as fresh. */
  freshness?: AuditFreshness;
  runnerPreview?: AuditRunnerPreview;
  /** The offer is in the archive: the section renders no island, whatever the audit's data says. */
  archived?: boolean;
}

