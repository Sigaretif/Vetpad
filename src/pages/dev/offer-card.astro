---
import AppLayout from "@/layouts/AppLayout.astro";
import Banner from "@/components/Banner.astro";
import DuplicateNotice from "@/components/offers/DuplicateNotice.astro";
import OfferNotFound from "@/components/offers/OfferNotFound.astro";
import OfferView from "@/components/offers/OfferView.astro";
import type { Saver } from "@/lib/members";
import type { OfferNotes } from "@/lib/notes";
import type { OfferRow } from "@/lib/otodom/types";
import {
  deletedSaver,
  failedNotes,
  fullNotes,
  fullOffer,
  longEmailSaver,
  longNotes,
  longTitleOffer,
  memberSaver,
  noNotes,
  othersOnlyNotes,
  selfSaver,
  singleImageOffer,
  unknownOffer,
  unknownSaver,
  unsafeImagesOffer,
} from "@/pages/dev/_offer-fixtures";

// Visual gate for the offer card: every named state at once, from fixtures, in `astro dev` only.
// Anywhere else (a production build, `npm run preview`) it answers 404 — `scripts/smoke.mjs`
// checks that on the production preview. The status is set on Astro.response, not returned,
// because a top-level `return` crashes @typescript-eslint/no-misused-promises.
const isDev = import.meta.env.DEV;
if (!isDev) {
  Astro.response.status = 404;
}

interface State {
  caption: string;
  offer: OfferRow;
  saver: Saver;
  notes: OfferNotes;
  noteError?: string;
  startEditing?: boolean;
}

// Each state renders the whole view (card + team column); `notatki-<n>` keeps the sections' ids
// unique on one page. The editor islands post to /api/notes for fixture offers that do not exist.
const states: State[] = [
  {
    caption: "Pełna oferta · autor: członek zespołu · notatki: własna w podglądzie, członka, usuniętego konta",
    offer: fullOffer,
    saver: memberSaver,
    notes: fullNotes,
  },
  {
    caption:
      "Wszystko nieznane (brak linku do oryginału) · autor: osoba z usuniętym kontem · notatki: brak (pusty formularz)",
    offer: unknownOffer,
    saver: deletedSaver,
    notes: noNotes,
  },
  {
    caption:
      "Jedno zdjęcie · autor: oglądający (Ciebie) · notatki: bez własnej, autor nieustalony i długi adres, puste pole",
    offer: singleImageOffer,
    saver: selfSaver,
    notes: othersOnlyNotes,
  },
  {
    caption:
      "Filtr adresów zdjęć (http: i javascript: odrzucone) · autor nieustalony · notatki: błąd odczytu po nieudanym zapisie",
    offer: unsafeImagesOffer,
    saver: unknownSaver,
    notes: failedNotes,
    noteError: "Nie udało się zapisać notatki. Spróbuj ponownie.",
  },
  {
    caption:
      "Długi tytuł bez spacji, długi opis · autor: członek z długim adresem · notatki: własna w edycji z błędem zapisu, długie słowo i akapity",
    offer: longTitleOffer,
    saver: longEmailSaver,
    notes: longNotes,
    noteError: "Nie udało się zapisać notatki. Spróbuj ponownie.",
    startEditing: true,
  },
];

const stateClass = "border-border flex flex-col gap-6 border-t pt-6";
const captionClass = "text-muted-foreground font-mono text-xs tracking-wide uppercase";
---

{isDev ? (
  <AppLayout wide title="Karta oferty — stany — Vetpad">
    <DuplicateNotice slot="notice" saver={memberSaver} />
    <DuplicateNotice slot="notice" saver={longEmailSaver} />
    <DuplicateNotice slot="notice" saver={selfSaver} />
    <DuplicateNotice slot="notice" saver={deletedSaver} />
    <DuplicateNotice slot="notice" saver={unknownSaver} />
    <Banner slot="notice" variant="warning">
      <strong>Uwaga:</strong> Supabase nie jest skonfigurowany — funkcje uwierzytelniania są wyłączone.{" "}
      <a href="https://github.com/Sigaretif/Vetpad#supabase-configuration" target="_blank" rel="noopener noreferrer">
        Zobacz instrukcję konfiguracji
      </a>
      .
    </Banner>
    <Banner slot="notice" variant="error">
      <strong>Uwaga:</strong> Supabase nie jest skonfigurowany — funkcje uwierzytelniania są wyłączone.{" "}
      <a href="https://github.com/Sigaretif/Vetpad#supabase-configuration" target="_blank" rel="noopener noreferrer">
        Zobacz instrukcję konfiguracji
      </a>
      .
    </Banner>

    <p class="text-muted-foreground text-sm">
      Strona testowa (tylko <code>astro dev</code>): karta oferty w każdym stanie, z danych testowych. Zmiana wyglądu
      karty przechodzi przez zrzut tej strony. Każdy stan pokazuje też kolumnę „Notatki zespołu” w innym wariancie.
    </p>

    {states.map((state, index) => (
      <div class:list={stateClass}>
        <p class:list={captionClass}>Stan: {state.caption}</p>
        <OfferView
          offer={state.offer}
          saver={state.saver}
          notes={state.notes}
          noteError={state.noteError}
          startEditing={state.startEditing}
          notesAnchorId={`notatki-${index + 1}`}
        />
      </div>
    ))}

    <div class:list={stateClass}>
      <p class:list={captionClass}>Stan: nie znaleziono oferty</p>
      <OfferNotFound />
    </div>
  </AppLayout>
) : (
  <AppLayout title="Nie znaleziono — Vetpad">
    <OfferNotFound />
  </AppLayout>
)}
