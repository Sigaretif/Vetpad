// The gallery's photo viewer on its own, in a column as wide as the card's: `?open=photo-<n>`
// (1-based) opens it on photo N on the first render, through `openAt`. The dialog is modal, so only
// this section ever opens — no other state on the page passes `openAt`. Anything else in the
// parameter, a number past the last photo included, leaves it closed.
const viewerPhotoCount = galleryPhotos(fullOffer.images).length;
const viewerOpenAt = clampOpenAt(Astro.url.searchParams.get("open"), viewerPhotoCount) ?? undefined;

/** The kind of start the card page would pass for an offer: `commuteOrigin` of its row. */
function startOf(offer: OfferRow): CommuteOrigin["kind"] | null {
  const read = readCommuteOffer(offer);
  return read === null ? null : (commuteOrigin(read)?.kind ?? null);
}

interface CommuteState {
  /** `data-state` of the wrapper. */
  state: string;
  caption: string;
  points: CommutePointsResult;
  origin: CommuteOrigin["kind"] | null;
  available: boolean;
  /** Whether the page would hold a browser key. Never a real key: the kitchen sink mounts no map. */
  map: boolean;
  archived?: boolean;
  preview?: CommutePreview;
}

// Stands in for a browser key on the kitchen sink, so the result states show where the map would
// be. It is never a key, and never reaches Google: it is passed only beside `preview`, with which the
// island mounts no map at all — an idle state, whose button can post, gets no key.
const PREVIEW_MAP_KEY = "podglad-bez-mapy";

// The commute section on its own, in a column as wide as the team column (24rem), through the
// production component. Every state that shows the island's run or result opens it through its
// `preview` prop: nothing is sent, and the map's place is taken by a placeholder — this page loads
// no Google script in any state. The idle states' button posts, on a click, to /api/commute for a
// fixture offer that does not exist: the route answers `offer_not_found` before it looks for a key.
const commuteStates: CommuteState[] = [
  {
    state: "commute-idle",
