    origin: "coordinates",
    available: true,
    map: true,
  },
  {
    state: "commute-unavailable",
    caption: "brak klucza Google Maps do tras — przycisk wyłączony z wyjaśnieniem",
    points: commutePoints,
    origin: "coordinates",
    available: false,
    map: false,
  },
  {
    state: "commute-archived",
    caption: "oferta w archiwum — zdanie zamiast przycisku",
    points: commutePoints,
    origin: "coordinates",
    available: true,
    map: true,
    archived: true,
  },
  {
    state: "commute-no-origin",
    caption: "ogłoszenie bez współrzędnych i lokalizacji — zdanie zamiast przycisku",
    points: commutePoints,
    origin: null,
    available: true,
    map: true,
  },
  {
    state: "commute-no-points",
    caption: "zespół bez punktów — odnośnik do kryteriów",
    points: noCommutePoints,
    origin: "coordinates",
    available: true,
    map: true,
  },
  {
    state: "commute-points-error",
    caption: "nieudany odczyt punktów — bez przycisku",
    points: failedCommutePoints,
    origin: "coordinates",
    available: true,
    map: true,
  },
  {
    state: "commute-running",
    caption: "liczenie w toku",
    points: commutePoints,
    origin: "coordinates",
    available: true,
    map: true,
    preview: { kind: "running" },
  },
  {
    state: "commute-result-transit",
    caption: "wynik — komunikacja, start ze współrzędnych, miejsce mapy",
    points: commutePoints,
    origin: "coordinates",
    available: true,
    map: true,
    preview: { kind: "result", result: commuteResult, mode: "transit" },
  },
  {
    state: "commute-result-drive",
    caption: "wynik — samochód",
    points: commutePoints,
    origin: "coordinates",
    available: true,
    map: true,
    preview: { kind: "result", result: commuteResult, mode: "drive" },
  },
  {
    state: "commute-result-six",
    caption: "wynik — sześć punktów, każdy kolor trasy raz, długa nazwa",
    points: commutePoints,
    origin: "coordinates",
    available: true,
    map: true,
    preview: { kind: "result", result: commuteResultSix, mode: "transit" },
  },
  {
    state: "commute-row-no-route",
    caption: "wiersz bez trasy komunikacją, start z lokalizacji i ulicy",
    points: commutePoints,
    origin: "address",
    available: true,
    map: true,
    preview: { kind: "result", result: commuteResultNoRoute, mode: "transit" },
  },
  {
    state: "commute-row-address-rejected",
    caption: "wiersz z adresem odrzuconym przez Google",
    points: commutePoints,
    origin: "coordinates",
    available: true,
    map: true,
    preview: { kind: "result", result: commuteResultRejected, mode: "drive" },
  },
  {
    state: "commute-map-missing",
    caption: "wynik bez klucza do mapy — tabela bez mapy",
    points: commutePoints,
    origin: "coordinates",
    available: true,
    map: false,
    preview: { kind: "result", result: commuteResult, mode: "transit" },
  },
  ...COMMUTE_FAILURE_REASONS.map((reason): CommuteState => ({
    state: `commute-failed-${reason}`,
    caption: `liczenie nieudane — ${reason}`,
    points: commutePoints,
    origin: "coordinates",
    available: true,
    map: true,
    preview: { kind: "failed", reason },
  })),
  {
    state: "commute-unreadable",
    caption: "odpowiedź, która nie jest strumieniem liczenia (strona 503) — bez ponowienia",
    points: commutePoints,
    origin: "coordinates",
    available: true,
    map: true,
    preview: { kind: "unreadable", status: 503 },
  },
];

const stateClass = "border-border flex flex-col gap-6 border-t pt-6";
const captionClass = "text-muted-foreground font-mono text-xs tracking-wide uppercase";
---

{isDev ? (
  <AppLayout wide title="Karta oferty — stany — Vetpad">
    <DuplicateNotice slot="notice" saver={memberSaver} offerId={fullOffer.id} />
    <DuplicateNotice slot="notice" saver={longEmailSaver} offerId={fullOffer.id} />
    <DuplicateNotice slot="notice" saver={selfSaver} offerId={fullOffer.id} />
    <DuplicateNotice slot="notice" saver={deletedSaver} offerId={fullOffer.id} />
    <DuplicateNotice slot="notice" saver={unknownSaver} offerId={fullOffer.id} />
    <DuplicateNotice slot="notice" saver={memberSaver} offerId={archivedOffer.id} archive={archivedByMember} />
    <DuplicateNotice slot="notice" saver={unknownSaver} offerId={archivedOffer.id} archive={archivedByUnknown} />
    <DuplicateNotice
      slot="notice"
      saver={longEmailSaver}
      offerId={archivedByDeletedOffer.id}
      archive={archivedByDeleted}
    />
    <ArchiveNotice slot="notice" result="archived" archive={archivedBySelf} />
    <ArchiveNotice slot="notice" result="restored" archive={null} />
    <ArchiveNotice slot="notice" result="already-archived" archive={archivedByMember} />
    <ArchiveNotice slot="notice" result="already-archived" archive={archivedByUnknown} />
    <ArchiveNotice slot="notice" result="already-live" archive={null} />
    <NoteDeleteNotice slot="notice" result="deleted" hasOwnNote={false} />
    <NoteDeleteNotice slot="notice" result="gone" hasOwnNote={false} />
    <Banner slot="notice" variant="warning">
      <strong>Uwaga:</strong> Supabase nie jest skonfigurowany — funkcje uwierzytelniania są wyłączone.{" "}
      <a href="https://github.com/Sigaretif/Vetpad#supabase-configuration" target="_blank" rel="noopener noreferrer">
        Zobacz instrukcję konfiguracji
      </a>
      .
    </Banner>
    <Banner slot="notice" variant="error">
      <strong>Uwaga:</strong> Supabase nie jest skonfigurowany — funkcje uwierzytelniania są wyłączone.{" "}
      <a href="https://github.com/Sigaretif/Vetpad#supabase-configuration" target="_blank" rel="noopener noreferrer">
        Zobacz instrukcję konfiguracji
      </a>
      .
    </Banner>

    <p class="text-muted-foreground text-sm">
      Strona testowa (tylko <code>astro dev</code>): karta oferty w każdym stanie, z danych testowych. Zmiana wyglądu
      karty przechodzi przez zrzut tej strony. Każdy stan pokazuje też kolumnę zespołu — sekcję „Audyt AI” i „Notatki
      zespołu” — w innym wariancie. Pod kartami sekcja audytu stoi osobno w każdym stanie swojej macierzy. Stany
      archiwum: karta zarchiwizowana przez członka, oglądającego, usunięte konto i archiwizującego nieustalonego, sekcja
      audytu w archiwum (<code>audit-archived-*</code>), a u góry powiadomienie o duplikacie zarchiwizowanej oferty i
      komunikaty po archiwizacji i przywróceniu. Usuwanie: blok „Usuń ofertę” stoi na każdej karcie, żywej i
      zarchiwizowanej, trzy stany pokazują nieudane usunięcie oferty i notatki, a u góry stoją oba komunikaty po
      usunięciu własnej notatki. Dojazdy: sekcja stoi pod notatkami na każdej karcie (bez klucza tras), a niżej osobno w
      każdym stanie (<code>commute-*</code>) — wyniki i przebieg liczenia z podglądu, bez mapy Google.
    </p>

    {states.map((state, index) => (
      <div class:list={stateClass}>
        <p class:list={captionClass}>Stan: {state.caption}</p>
        <OfferView
          offer={state.offer}
          saver={state.saver}
          notes={state.notes}
          audit={state.audit}
          auditAvailable={state.auditAvailable}
          freshness={freshnessOf(state.audit, state.freshness)}
          noteError={state.noteError}
          refetchError={state.refetchError}
          lost={state.lost}
          startEditing={state.startEditing}
          notesAnchorId={`notatki-${index + 1}`}
          auditAnchorId={`audyt-${index + 1}`}
          refetchAnchorId={`pobranie-${index + 1}`}
          archive={state.archive}
          archiveError={state.archiveError}
          archiveAnchorId={`archiwum-${index + 1}`}
          deleteError={state.deleteError}
          deleteAnchorId={`usuwanie-${index + 1}`}
          noteDeleteError={state.noteDeleteError}
          commutePoints={commutePoints}
          commuteOrigin={startOf(state.offer)}
          commuteAvailable={false}
          commuteMapKey={null}
          commuteAnchorId={`dojazdy-${index + 1}`}
        />
      </div>
    ))}

    {auditStates.map((state) => (
      <div class:list={stateClass} data-state={state.state}>
        <p class:list={captionClass}>
          Audyt · {state.matrix}: {state.caption}
        </p>
        <div class="w-full max-w-sm">
          <OfferAudit
            offerId={fullOffer.id}
            audit={state.audit}
            available={state.available}
            freshness={freshnessOf(state.audit, state.freshness)}
            anchorId={`audyt-${state.state}`}
            runnerPreview={state.runnerPreview}
            archived={state.archived}
          />
        </div>
      </div>
    ))}

    {commuteStates.map((state) => (
      <div class:list={stateClass} data-state={state.state}>
        <p class:list={captionClass}>Dojazdy: {state.caption}</p>
        <div class="w-full max-w-sm">
          <OfferCommute
            offerId={fullOffer.id}
            points={state.points}
            origin={state.origin}
            available={state.available}
            mapKey={state.map && state.preview !== undefined ? PREVIEW_MAP_KEY : null}
            archived={state.archived}
            anchorId={`dojazdy-${state.state}`}
            runnerPreview={state.preview}
          />
        </div>
      </div>
    ))}

    <div class:list={stateClass} data-state="gallery-viewer">
      <p class:list={captionClass}>
        Galeria — przeglądarka zdjęć: klik miniatury otwiera dialog, ←/→ i przyciski zawijają, Esc i „Zamknij” zamykają
      </p>
      <p class="text-sm">
        Otwórz na zdjęciu:{" "}
        {Array.from({ length: viewerPhotoCount }, (_, index) => (
          <>
            <a href={`?open=photo-${index + 1}`} class="text-link underline-offset-4 hover:underline">
              {index + 1}
            </a>{" "}
          </>
        ))}
        ·{" "}
        <a href={Astro.url.pathname} class="text-link underline-offset-4 hover:underline">
          zamknięta
        </a>
      </p>
      <div class="grid gap-6 lg:grid-cols-[minmax(0,1fr)_minmax(0,24rem)] lg:items-start">
        <div class="flex min-w-0 flex-col gap-6">
          <OfferGallery images={fullOffer.images} title={fullOffer.title} openAt={viewerOpenAt} />
        </div>
      </div>
    </div>

    <div class:list={stateClass}>
      <p class:list={captionClass}>Stan: nie znaleziono oferty</p>
      <OfferNotFound />
    </div>
  </AppLayout>
) : (
  <AppLayout title="Nie znaleziono — Vetpad">
    <OfferNotFound />
  </AppLayout>
)}
