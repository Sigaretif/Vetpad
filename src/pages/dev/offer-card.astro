// Visual gate for the offer card: every named state at once, from fixtures, in `astro dev` only.
// Anywhere else (a production build, `npm run preview`) it answers 404 — `scripts/smoke.mjs`
// checks that on the production preview. The status is set on Astro.response, not returned,
// because a top-level `return` crashes @typescript-eslint/no-misused-promises.
const isDev = import.meta.env.DEV;
if (!isDev) {
  Astro.response.status = 404;
}

interface State {
  caption: string;
  offer: OfferRow;
  saver: Saver;
  notes: OfferNotes;
  audit: OfferAuditData;
  auditAvailable: boolean;
  /** What the page would have worked out for the audit's result; left out, a result reads as fresh. */
  freshness?: AuditFreshness;
  noteError?: string;
  refetchError?: string;
  /** The card's `?lost=`, as the address would carry it. */
  lost?: string;
  startEditing?: boolean;
  /** Who archived the offer, as the page would have named them; the state itself is the row's. */
  archive?: OfferArchiveState;
  archiveError?: string;
  /** A failed deletion of the offer, as `?error=…&form=delete` would carry it. */
  deleteError?: string;
  /** A failed deletion of the member's own note, as `?error=…&form=note-delete` would carry it. */
  noteDeleteError?: string;
}

/** The freshness a state passes down: its own, or `fresh` for a stored result and `null` without one. */
function freshnessOf(audit: OfferAuditData, freshness: AuditFreshness | undefined): AuditFreshness | null {
  if (audit.state !== "ok" || audit.result === null) return null;
  return freshness ?? freshAudit;
}

// Each state renders the whole view (card + team column); `notatki-<n>`, `audyt-<n>`,
// `pobranie-<n>`, `archiwum-<n>` and `usuwanie-<n>` keep the sections' ids unique on one page. Every
// card carries the delete block as well (FR-015): its button opens a confirmation, and a confirmed
// one posts to /api/offer-delete for a fixture offer that does not exist, so nothing is deleted. Every card carries
// the archive block too, and the notices above carry its restore button: it posts to
// /api/offer-archive for a fixture offer that does not exist, and the route answers
// `offer_missing` without writing anything. Every card carries the re-fetch block,
// and the duplicate notices above carry the same button: it posts to /api/offer-refetch for a
// fixture offer that does not exist, and the route answers `offer_missing` before it fetches
// anything, so a click here cannot reach otodom.pl. Nothing is sent without a click. The editor islands post to /api/notes, and the audit buttons
// to /api/audits, for fixture offers that do not exist: the audit route answers `offer_not_found`
// before it looks for a provider key, so a click here cannot reach the model provider.
// A failed re-fetch in the route's own words (`@/lib/otodom/failure`).
