---
import AppLayout from "@/layouts/AppLayout.astro";
import SignInForm from "@/components/auth/SignInForm";
import AddOfferForm from "@/components/offers/AddOfferForm";
import NoteEditor from "@/components/offers/NoteEditor";
import RefetchForm from "@/components/offers/RefetchForm";
import ArchiveForm from "@/components/offers/ArchiveForm";
import DeleteOfferForm from "@/components/offers/DeleteOfferForm";
import TeamLimitsForm from "@/components/criteria/TeamLimitsForm";
import RequirementsEditor from "@/components/criteria/RequirementsEditor";
import AuditSettingsForm from "@/components/criteria/AuditSettingsForm";
import { Button } from "@/components/ui/button";
import { FormField } from "@/components/form/FormField";
import { PasswordToggle } from "@/components/form/PasswordToggle";
import { SubmitButton } from "@/components/form/SubmitButton";
import { ServerError } from "@/components/form/ServerError";
import { SelectField } from "@/components/form/SelectField";
import { TextareaField } from "@/components/form/TextareaField";
import { NOTE_BLANK, NOTE_FIELDS, NOTE_FIELD_LABELS, NOTE_MAX_LENGTH } from "@/lib/notes";
import { REQUIREMENTS_BLANK, REQUIREMENTS_MAX_LENGTH } from "@/lib/criteria";
import { ingestFailureMessage } from "@/lib/otodom/failure";
import {
  AUDIT_EFFORTS,
  AUDIT_EFFORT_LABELS,
  AUDIT_MODELS,
  AUDIT_MODEL_LABELS,
  DEFAULT_AUDIT_SETTINGS,
} from "@/lib/audit/settings";
import { fullLimits } from "@/pages/dev/_criteria-fixtures";
import {
  Archive,
  ArchiveRestore,
  Banknote,
  CircleAlert,
  Eraser,
  Mail,
  Lock,
  LogIn,
  Link as LinkIcon,
  MapPin,
  Plus,
  RefreshCw,
  Ruler,
  Save,
} from "lucide-react";
import { createElement } from "react";

// Visual gate for the shared form composites: every named state of SignInForm, AddOfferForm,
// NoteEditor, TeamLimitsForm, RequirementsEditor, AuditSettingsForm, RefetchForm, ArchiveForm and
// DeleteOfferForm at once, in `astro dev` only. Anywhere else
// (a production build, `npm run preview`) it answers 404 — `scripts/smoke.mjs` checks that on the
// production preview. The status is set on
// Astro.response, not returned, because a top-level `return` crashes
// @typescript-eslint/no-misused-promises. Pattern: `src/pages/dev/offer-card.astro`.
const isDev = import.meta.env.DEV;
if (!isDev) {
  Astro.response.status = 404;
}

// Composites rendered server-side (no client:*) never call onChange; this satisfies the prop.
const noop = () => undefined;

// Astro's own template syntax has no JSX-expression runtime, so a React element built for a prop
// (an icon, a `PasswordToggle`) is created with `createElement`, not with a nested `<Tag />`
// literal inside `{}` — that compiles, but the resulting page silently renders as an empty body.
const mailIcon = createElement(Mail, { className: "size-4" });
const lockIcon = createElement(Lock, { className: "size-4" });
const linkIcon = createElement(LinkIcon, { className: "size-4" });
const logInIcon = createElement(LogIn, { className: "size-4" });
const plusIcon = createElement(Plus, { className: "size-4" });
const saveIcon = createElement(Save, { className: "size-4" });
const cityIcon = createElement(MapPin, { className: "size-4" });
const priceIcon = createElement(Banknote, { className: "size-4" });
const areaIcon = createElement(Ruler, { className: "size-4" });
const eraserIcon = createElement(Eraser);
const refetchIcon = createElement(RefreshCw, { className: "size-4" });
const archiveIcon = createElement(Archive, { className: "size-4" });
const restoreIcon = createElement(ArchiveRestore, { className: "size-4" });

// The limits form's fields as TeamLimitsForm lays them out, for the composite-only states.
const limitFields = [
  { name: "city", label: "Miasto", placeholder: "np. Warszawa", icon: cityIcon },
  { name: "price_min", label: "Cena od (zł)", placeholder: "np. 600 000", icon: priceIcon, inputMode: "numeric" },
  { name: "price_max", label: "Cena do (zł)", placeholder: "np. 900 000", icon: priceIcon, inputMode: "numeric" },
  { name: "area_min", label: "Minimalny metraż (m²)", placeholder: "np. 45", icon: areaIcon, inputMode: "decimal" },
] as const;
// A reversed price range: the one limits error that belongs to two fields, reported on „Cena od".
const reversedRange: Record<(typeof limitFields)[number]["name"], string> = {
  city: "Warszawa",
  price_min: "950 000",
  price_max: "600 000",
  area_min: "45",
};

// The audit settings' two lists as AuditSettingsForm fills them, for the composite-only states.
const modelOptions = AUDIT_MODELS.map((model) => ({ value: model, label: AUDIT_MODEL_LABELS[model].name }));
const effortOptions = AUDIT_EFFORTS.map((effort) => ({ value: effort, label: AUDIT_EFFORT_LABELS[effort].name }));

// The note editor posts for an offer; this fixture offer does not exist, so a save here fails.
// RefetchForm posts for the same offer: the route answers `offer_missing` before it fetches
// anything, so a click here cannot reach otodom.pl, and nothing is sent without a click.
// ArchiveForm posts for it as well: the route answers `offer_missing` without writing anything.
const noteOfferId = "00000000-0000-4000-8000-000000000001";
// A failed re-fetch in the route's own words (`@/lib/otodom/failure`).
const REFETCH_TIMED_OUT = ingestFailureMessage("timeout", undefined, "refetch");
// A failed archiving, in the words of POST /api/offer-archive.
const ARCHIVE_FAILED = "Nie udało się zarchiwizować oferty. Oferta pozostała na tablicy — spróbuj ponownie.";
// A failed deletion of the offer and of the note, in the words of POST /api/offer-delete and POST /api/notes.
const DELETE_FAILED =
  "Nie udało się usunąć oferty. Oferta, jej notatki i wynik audytu pozostały bez zmian — spróbuj ponownie.";
const NOTE_DELETE_FAILED = "Nie udało się usunąć notatki. Notatka pozostała bez zmian — spróbuj ponownie.";
// DeleteOfferForm and the note's „Usuń" post for the same missing offer: both routes answer that
// there was nothing to delete, and nothing is sent before the confirmation in the dialog.
const savedNote = {
  pros: "Jasna kuchnia, balkon od południa.",
  cons: "Głośna ulica od strony sypialni.",
  observations: "",
  updatedAt: "2026-10-09T17:20:00.000Z",
};
// A dialog is modal: one open over the page hides the rest of it. So no section opens one on its
// own — `?open=` names the one dialog to render open, and every other section stays reachable
// with a click on its button.
const openDialog = Astro.url.searchParams.get("open");
const hiddenPasswordToggle = createElement(PasswordToggle, { visible: false, onToggle: noop });

const stateClass = "border-border flex flex-col gap-6 border-t pt-6";
const captionClass = "text-muted-foreground font-mono text-xs tracking-wide uppercase";
const gridClass = "grid gap-8 sm:grid-cols-2 lg:grid-cols-3";
const columnClass = "flex flex-col gap-4";
const labelClass = "text-foreground text-sm font-medium";
const noteClass = "text-muted-foreground text-sm";
---

{isDev ? (
  <AppLayout title="Formularze — stany — Vetpad">
    <p class="text-muted-foreground text-sm">
      Strona testowa (tylko <code>astro dev</code>): <code>SignInForm</code>, <code>AddOfferForm</code>,{" "}
      <code>NoteEditor</code>, <code>TeamLimitsForm</code>, <code>RequirementsEditor</code>,{" "}
      <code>AuditSettingsForm</code>, <code>RefetchForm</code>, <code>ArchiveForm</code> i <code>DeleteOfferForm</code>{" "}
      w każdym nazwanym stanie, złożonym z tych samych kompozytów (<code>src/components/form/</code>), których używają
      formularze w produkcji. Zmiana wyglądu formularza przechodzi przez zrzut tej strony.
    </p>

    <div class:list={stateClass} data-state="default">
      <p class:list={captionClass}>Stan: default</p>
      <div class:list={gridClass}>
        <div class:list={columnClass} data-form="signin">
          <p class:list={labelClass}>SignInForm</p>
          <SignInForm client:load />
        </div>
        <div class:list={columnClass} data-form="offer">
          <p class:list={labelClass}>AddOfferForm</p>
          <AddOfferForm client:load />
        </div>
        <div class:list={columnClass} data-form="note">
          <p class:list={labelClass}>NoteEditor</p>
          <NoteEditor client:load offerId={noteOfferId} note={null} />
        </div>
        <div class:list={columnClass} data-form="limits">
          <p class:list={labelClass}>TeamLimitsForm</p>
          <TeamLimitsForm client:load limits={fullLimits} />
        </div>
        <div class:list={columnClass} data-form="requirements">
          <p class:list={labelClass}>RequirementsEditor</p>
          <RequirementsEditor client:load own={null} />
        </div>
        <div class:list={columnClass} data-form="audit">
          <p class:list={labelClass}>AuditSettingsForm</p>
          <AuditSettingsForm client:load settings={DEFAULT_AUDIT_SETTINGS} />
        </div>
        <div class:list={columnClass} data-form="refetch">
          <p class:list={labelClass}>RefetchForm</p>
          <RefetchForm client:load offerId={noteOfferId} />
        </div>
        <div class:list={columnClass} data-form="archive">
          <p class:list={labelClass}>ArchiveForm · archiwizuj</p>
          <ArchiveForm client:load offerId={noteOfferId} intent="archive" />
        </div>
        <div class:list={columnClass} data-form="archive-restore">
          <p class:list={labelClass}>ArchiveForm · przywróć</p>
          <ArchiveForm client:load offerId={noteOfferId} intent="restore" />
        </div>
      </div>
    </div>

    <div class:list={stateClass} data-state="hover">
      <p class:list={captionClass}>Stan: hover</p>
      <div class:list={gridClass}>
        <div class:list={columnClass} data-form="signin">
          <p class:list={labelClass}>SignInForm</p>
          <p class:list={noteClass}>
            Przycisk „Zaloguj”: zrzut <code>forms-hover-button</code> wymusza <code>:hover</code> (CDP{" "}
            <code>CSS.forcePseudoState</code>) na ten sam przycisk w stanie „default” powyżej.
          </p>
          <p class:list={noteClass}>
            Pole: nie dotyczy — <code>Input</code> nie ma stanu hover, a pole sygnalizuje interakcję fokusem.
          </p>
        </div>
        <div class:list={columnClass} data-form="offer">
          <p class:list={labelClass}>AddOfferForm</p>
          <p class:list={noteClass}>
            Przycisk „Dodaj ofertę”: ten sam <code>SubmitButton</code>/<code>Button</code>, więc pokryty zrzutem obok.
          </p>
          <p class:list={noteClass}>Pole: nie dotyczy (jak obok).</p>
        </div>
        <div class:list={columnClass} data-form="note">
          <p class:list={labelClass}>NoteEditor</p>
          <p class:list={noteClass}>
            Przycisk „Zapisz notatkę” w stanie „default” powyżej: zrzut <code>forms-hover-note-submit</code> wymusza{" "}
            <code>:hover</code>.
          </p>
          <p class:list={noteClass}>
            Pole: nie dotyczy — <code>Textarea</code>, jak <code>Input</code>, nie ma stanu hover.
          </p>
        </div>
        <div class:list={columnClass} data-form="limits">
          <p class:list={labelClass}>TeamLimitsForm</p>
          <p class:list={noteClass}>
            „Zapisz limity” to ten sam <code>SubmitButton</code> co „Zaloguj”; „Wyczyść limity” to <code>Button</code> w
            wariancie <code>outline</code>, jak „Edytuj” notatki (zrzut <code>gate-hover-note-edit</code>). Pola: nie
            dotyczy (jak obok).
          </p>
        </div>
        <div class:list={columnClass} data-form="requirements">
          <p class:list={labelClass}>RequirementsEditor</p>
          <p class:list={noteClass}>
            Przycisk „Zapisz wymagania” w stanie „default” powyżej: zrzut <code>forms-hover-requirements-submit</code>{" "}
            wymusza <code>:hover</code>. Pole: nie dotyczy (jak obok).
          </p>
        </div>
        <div class:list={columnClass} data-form="audit">
          <p class:list={labelClass}>AuditSettingsForm</p>
          <p class:list={noteClass}>
            Przycisk „Zapisz ustawienia” w stanie „default” powyżej: zrzut <code>forms-hover-audit-submit</code> wymusza{" "}
            <code>:hover</code>. Wyzwalacz listy ma własny stan hover (<code>dark:hover:bg-input/50</code>): zrzut{" "}
            <code>forms-hover-audit-select</code>.
          </p>
        </div>
        <div class:list={columnClass} data-form="refetch">
          <p class:list={labelClass}>RefetchForm</p>
          <p class:list={noteClass}>
            Przycisk „Pobierz ponownie z otodom.pl”: ten sam <code>SubmitButton</code>/<code>Button</code> co „Zaloguj”.
            Pól nie ma.
          </p>
        </div>
        <div class:list={columnClass} data-form="archive">
          <p class:list={labelClass}>ArchiveForm</p>
          <p class:list={noteClass}>
            Przyciski „Zarchiwizuj” i „Przywróć”: ten sam <code>SubmitButton</code>/<code>Button</code> co „Zaloguj”.
            Pól nie ma.
          </p>
        </div>
      </div>
    </div>

    <div class:list={stateClass} data-state="focus">
      <p class:list={captionClass}>Stan: focus</p>
      <div class:list={gridClass}>
        <div class:list={columnClass} data-form="signin">
          <p class:list={labelClass}>SignInForm</p>
          <p class:list={noteClass}>
            Pole e-mail, przełącznik hasła i przycisk „Zaloguj” w stanie „default” powyżej, prawdziwymi naciśnięciami
            Tab (zrzuty <code>forms-focus-field</code>, <code>forms-focus-toggle</code>, <code>forms-focus-button</code>
            ). Pole z błędem: zrzut <code>forms-focus-field-error</code> celuje w pole e-mail w stanie „error” poniżej.
          </p>
        </div>
        <div class:list={columnClass} data-form="offer">
          <p class:list={labelClass}>AddOfferForm</p>
          <p class:list={noteClass}>
            Pole adresu i przycisk „Dodaj ofertę”: te same <code>FormField</code>/<code>SubmitButton</code>, co zrzuty
            obok.
          </p>
        </div>
        <div class:list={columnClass} data-form="note">
          <p class:list={labelClass}>NoteEditor</p>
          <p class:list={noteClass}>
            Pole „Zalety” w stanie „default” powyżej, prawdziwymi naciśnięciami Tab (zrzut{" "}
            <code>forms-focus-note-field</code>). <code>Textarea</code> ma ten sam pierścień fokusu co{" "}
            <code>Input</code> (<code>focus-visible:ring-ring/50</code>, a z błędem <code>ring-destructive/70</code>),
            przycisk to ten sam <code>SubmitButton</code>.
          </p>
        </div>
        <div class:list={columnClass} data-form="limits">
          <p class:list={labelClass}>TeamLimitsForm</p>
          <p class:list={noteClass}>
            Pole „Miasto” w stanie „default” powyżej, prawdziwymi naciśnięciami Tab (zrzut{" "}
            <code>forms-focus-limits-field</code>). Pozostałe pola to ten sam <code>FormField</code>, przyciski to{" "}
            <code>SubmitButton</code> i <code>Button</code>.
          </p>
        </div>
        <div class:list={columnClass} data-form="requirements">
          <p class:list={labelClass}>RequirementsEditor</p>
          <p class:list={noteClass}>
            Pole wymagań: ten sam <code>TextareaField</code> co „Zalety” notatki (zrzut{" "}
            <code>forms-focus-note-field</code>). „Edytuj” w podglądzie: zrzut na <code>/dev/criteria</code>.
          </p>
        </div>
        <div class:list={columnClass} data-form="audit">
          <p class:list={labelClass}>AuditSettingsForm</p>
          <p class:list={noteClass}>
            Wyzwalacz listy „Model” w stanie „default” powyżej, prawdziwymi naciśnięciami Tab (zrzut{" "}
            <code>forms-focus-audit-select</code>): ten sam pierścień fokusu co <code>Input</code>. Lista „Poziom
            rozumowania” to ten sam <code>SelectField</code>, przycisk to <code>SubmitButton</code>.
          </p>
        </div>
        <div class:list={columnClass} data-form="refetch">
          <p class:list={labelClass}>RefetchForm</p>
          <p class:list={noteClass}>
            Jedyny element z fokusem to przycisk — ten sam <code>SubmitButton</code>, co zrzut{" "}
            <code>forms-focus-button</code>.
          </p>
        </div>
        <div class:list={columnClass} data-form="archive">
          <p class:list={labelClass}>ArchiveForm</p>
          <p class:list={noteClass}>
            Jedyny element z fokusem to przycisk — ten sam <code>SubmitButton</code>, co zrzut{" "}
            <code>forms-focus-button</code>.
          </p>
        </div>
      </div>
    </div>

    <div class:list={stateClass} data-state="disabled">
      <p class:list={captionClass}>Stan: disabled</p>
      <div class:list={gridClass}>
        <div class:list={columnClass} data-form="signin">
          <p class:list={labelClass}>SignInForm</p>
          <p class:list={noteClass}>
            Przycisk: ten sam render co „loading” poniżej — <code>SubmitButton</code> blokuje się tylko w trakcie
            wysyłki, a osobny <code>disabled</code> byłby propsem tylko dla testów.
          </p>
          <p class:list={noteClass}>
            Pole: nie dotyczy — nigdy nie jest blokowane, bo POST jest już wysłany, a strona się przeładuje.
          </p>
        </div>
        <div class:list={columnClass} data-form="offer">
          <p class:list={labelClass}>AddOfferForm</p>
          <p class:list={noteClass}>Jak obok.</p>
        </div>
        <div class:list={columnClass} data-form="note">
          <p class:list={labelClass}>NoteEditor</p>
          <SubmitButton pending pendingText="Zapisuję…" icon={saveIcon}>
            Zapisz notatkę
          </SubmitButton>
          <p class:list={noteClass}>
            Przycisk zablokowany tylko w trakcie wysyłki (ten sam render co „loading”). Pola: nie dotyczy, jak obok.
          </p>
        </div>
        <div class:list={columnClass} data-form="limits">
          <p class:list={labelClass}>TeamLimitsForm</p>
          <SubmitButton pending pendingText="Zapisuję…" icon={saveIcon}>
            Zapisz limity
          </SubmitButton>
          <Button type="button" variant="outline" disabled>
            {eraserIcon}
            Wyczyść limity
          </Button>
          <p class:list={noteClass}>
            W trakcie wysyłki oba przyciski są zablokowane, żeby zapis i wyczyszczenie nie poszły naraz. Pola: nie
            dotyczy, jak obok.
          </p>
        </div>
        <div class:list={columnClass} data-form="requirements">
          <p class:list={labelClass}>RequirementsEditor</p>
          <SubmitButton pending pendingText="Zapisuję…" icon={saveIcon}>
            Zapisz wymagania
          </SubmitButton>
          <Button type="button" variant="ghost" disabled>
            Anuluj
          </Button>
          <p class:list={noteClass}>
            „Anuluj” (tylko przy edycji zapisanych wymagań) blokuje się razem z przyciskiem zapisu. Pole: nie dotyczy.
          </p>
        </div>
        <div class:list={columnClass} data-form="audit">
          <p class:list={labelClass}>AuditSettingsForm</p>
          <SubmitButton pending pendingText="Zapisywanie…" icon={saveIcon}>
            Zapisz ustawienia
          </SubmitButton>
          <p class:list={noteClass}>
            Przycisk zablokowany tylko w trakcie wysyłki (ten sam render co „loading”). Listy: nie dotyczy — nigdy nie
            są blokowane, bo POST jest już wysłany, a strona się przeładuje.
          </p>
        </div>
        <div class:list={columnClass} data-form="refetch">
          <p class:list={labelClass}>RefetchForm</p>
          <SubmitButton pending pendingText="Pobieram ogłoszenie…" icon={refetchIcon}>
            Pobierz ponownie z otodom.pl
          </SubmitButton>
          <p class:list={noteClass}>
            Przycisk zablokowany tylko w trakcie pobierania (ten sam render co „loading”), które trwa do 45 s.
          </p>
        </div>
        <div class:list={columnClass} data-form="archive">
          <p class:list={labelClass}>ArchiveForm</p>
          <SubmitButton pending pendingText="Archiwizuję…" icon={archiveIcon}>
            Zarchiwizuj
          </SubmitButton>
          <SubmitButton pending pendingText="Przywracam…" icon={restoreIcon}>
            Przywróć
          </SubmitButton>
          <p class:list={noteClass}>
            Przycisk zablokowany tylko w trakcie wysyłki (ten sam render co „loading”). W archiwum formularz się nie
            blokuje — zmienia się jego akcja.
          </p>
        </div>
      </div>
    </div>

    <div class:list={stateClass} data-state="error">
      <p class:list={captionClass}>Stan: error</p>
      <p class:list={noteClass}>
        Kompozyty: błąd pola i <code>ServerError</code>. Cały formularz z <code>serverError</code> jest na zrzutach{" "}
        <code>views-signin-error</code> i <code>views-dashboard-error</code> — drugi egzemplarz formularza na tej
        stronie zdublowałby identyfikatory pól.
      </p>
      <div class:list={gridClass}>
        <div class:list={columnClass} data-form="signin">
          <p class:list={labelClass}>SignInForm</p>
          <FormField
            id="error-email"
            placeholder="ty@przyklad.pl"
            type="email"
            label="E-mail"
            value="nie-adres"
            onChange={noop}
            error="Podaj poprawny adres e-mail"
            icon={mailIcon}
          />
          <ServerError message="Nieprawidłowy e-mail lub hasło." />
        </div>
        <div class:list={columnClass} data-form="offer">
          <p class:list={labelClass}>AddOfferForm</p>
          <FormField
            id="error-url"
            placeholder="https://www.otodom.pl/pl/oferta/…"
            type="url"
            label="Adres ogłoszenia"
            value="otodom oferta 123"
            onChange={noop}
            error="To nie wygląda na poprawny adres URL."
            icon={linkIcon}
          />
          <ServerError message="Vetpad obsługuje wyłącznie ogłoszenia z otodom.pl." />
        </div>
        <div class:list={columnClass} data-form="note">
          <p class:list={labelClass}>NoteEditor</p>
          {NOTE_FIELDS.map((field) => (
            <TextareaField
              id={`error-note-${field}`}
              name={field}
              label={NOTE_FIELD_LABELS[field]}
              value=""
              onChange={noop}
              maxLength={NOTE_MAX_LENGTH}
              invalid
              describedBy="error-note-message"
            />
          ))}
          <p id="error-note-message" class="text-destructive flex items-center gap-1 text-xs">
            <CircleAlert className="size-3 shrink-0" />
            {NOTE_BLANK}
          </p>
          <ServerError message="Nie udało się zapisać notatki. Spróbuj ponownie." />
        </div>
        <div class:list={columnClass} data-form="limits">
          <p class:list={labelClass}>TeamLimitsForm</p>
          {limitFields.map((field) => (
            <FormField
              id={`error-limits-${field.name}`}
              name={field.name}
              label={field.label}
              inputMode={"inputMode" in field ? field.inputMode : undefined}
              placeholder={field.placeholder}
              value={reversedRange[field.name]}
              onChange={noop}
              error={field.name === "price_min" ? "Cena od nie może być wyższa niż cena do." : undefined}
              icon={field.icon}
            />
          ))}
          <ServerError message="Nie udało się zapisać limitów. Spróbuj ponownie." />
        </div>
        <div class:list={columnClass} data-form="requirements">
          <p class:list={labelClass}>RequirementsEditor</p>
          <TextareaField
            id="error-requirements-body"
            name="body"
            label="Wymagania dodatkowe"
            value=""
            onChange={noop}
            maxLength={REQUIREMENTS_MAX_LENGTH}
            rows={6}
            invalid
            describedBy="error-requirements-message"
          />
          <p id="error-requirements-message" class="text-destructive flex items-center gap-1 text-xs">
            <CircleAlert className="size-3 shrink-0" />
            {REQUIREMENTS_BLANK}
          </p>
          <ServerError message="Nie udało się zapisać wymagań. Spróbuj ponownie." />
        </div>
        <div class:list={columnClass} data-form="audit">
          <p class:list={labelClass}>AuditSettingsForm</p>
          <ServerError message="Nie udało się zapisać ustawień audytu. Spróbuj ponownie." />
          <SelectField
            id="error-audit-model"
            name="model"
            label="Model"
            value={DEFAULT_AUDIT_SETTINGS.model}
            onChange={noop}
            options={modelOptions}
          />
          <SelectField
            id="error-audit-effort"
            name="effort"
            label="Poziom rozumowania"
            value={DEFAULT_AUDIT_SETTINGS.effort}
            onChange={noop}
            options={effortOptions}
          />
          <p class:list={noteClass}>
            Komunikat serwera stoi nad listami. Błąd pola: nie dotyczy — lista zamknięta nie przyjmuje wartości, którą
            trasa by odrzuciła. Nieudany odczyt ustawień (bez formularza): <code>/dev/criteria</code>, stan
            „audit-read-error”.
          </p>
        </div>
        <div class:list={columnClass} data-form="refetch">
          <p class:list={labelClass}>RefetchForm</p>
          <RefetchForm client:load offerId={noteOfferId} serverError={REFETCH_TIMED_OUT} />
          <p class:list={noteClass}>
            Cały formularz z <code>serverError</code>: nie ma pól, więc drugi egzemplarz nie dubluje identyfikatorów.
            Błąd pola: nie dotyczy.
          </p>
        </div>
        <div class:list={columnClass} data-form="archive">
          <p class:list={labelClass}>ArchiveForm</p>
          <ArchiveForm client:load offerId={noteOfferId} intent="archive" serverError={ARCHIVE_FAILED} />
          <p class:list={noteClass}>
            Cały formularz z <code>serverError</code> (z karty: <code>?error=…&amp;form=archive</code>). Pól nie ma,
            więc błąd pola nie dotyczy.
          </p>
        </div>
      </div>
    </div>

    <div class:list={stateClass} data-state="empty">
      <p class:list={captionClass}>Stan: empty</p>
      <div class:list={gridClass}>
        <div class:list={columnClass} data-form="signin">
          <p class:list={labelClass}>SignInForm</p>
          <FormField
            id="empty-email"
            placeholder="ty@przyklad.pl"
            type="email"
            label="E-mail"
            value=""
            onChange={noop}
            error="Podaj adres e-mail"
            icon={mailIcon}
          />
          <FormField
            id="empty-password"
            placeholder="Twoje hasło"
            type="password"
            label="Hasło"
            value=""
            onChange={noop}
            error="Podaj hasło"
            icon={lockIcon}
            endContent={hiddenPasswordToggle}
          />
        </div>
        <div class:list={columnClass} data-form="offer">
          <p class:list={labelClass}>AddOfferForm</p>
          <FormField
            id="empty-url"
            placeholder="https://www.otodom.pl/pl/oferta/…"
            type="url"
            label="Adres ogłoszenia"
            value=""
            onChange={noop}
            error="Wklej adres ogłoszenia z otodom.pl"
            icon={linkIcon}
          />
        </div>
        <div class:list={columnClass} data-form="note">
          <p class:list={labelClass}>NoteEditor</p>
          {NOTE_FIELDS.map((field) => (
            <TextareaField
              id={`empty-note-${field}`}
              name={field}
              label={NOTE_FIELD_LABELS[field]}
              value=""
              onChange={noop}
              maxLength={NOTE_MAX_LENGTH}
            />
          ))}
        </div>
        <div class:list={columnClass} data-form="limits">
          <p class:list={labelClass}>TeamLimitsForm</p>
          {limitFields.map((field) => (
            <FormField
              id={`empty-limits-${field.name}`}
              name={field.name}
              label={field.label}
              inputMode={"inputMode" in field ? field.inputMode : undefined}
              placeholder={field.placeholder}
              value=""
              onChange={noop}
              icon={field.icon}
            />
          ))}
          <p class:list={noteClass}>Puste pole to brak limitu, nie błąd — formularz bez limitów zapisuje się.</p>
        </div>
        <div class:list={columnClass} data-form="requirements">
          <p class:list={labelClass}>RequirementsEditor</p>
          <TextareaField
            id="empty-requirements-body"
            name="body"
            label="Wymagania dodatkowe"
            value=""
            onChange={noop}
            maxLength={REQUIREMENTS_MAX_LENGTH}
            rows={6}
          />
        </div>
        <div class:list={columnClass} data-form="audit">
          <p class:list={labelClass}>AuditSettingsForm</p>
          <p class:list={noteClass}>
            Nie dotyczy: wiersz ustawień istnieje od migracji i zawsze ma model i poziom rozumowania, więc formularz
            nigdy nie otwiera się pusty.
          </p>
        </div>
        <div class:list={columnClass} data-form="refetch">
          <p class:list={labelClass}>RefetchForm</p>
          <p class:list={noteClass}>Nie dotyczy: formularz nie ma pól do wypełnienia.</p>
        </div>
        <div class:list={columnClass} data-form="archive">
          <p class:list={labelClass}>ArchiveForm</p>
          <p class:list={noteClass}>Nie dotyczy: formularz nie ma pól do wypełnienia.</p>
        </div>
      </div>
    </div>

    <div class:list={stateClass} data-state="loading">
      <p class:list={captionClass}>Stan: loading</p>
      <div class:list={gridClass}>
        <div class:list={columnClass} data-form="signin">
          <p class:list={labelClass}>SignInForm</p>
          <SubmitButton pending pendingText="Loguję…" icon={logInIcon}>
            Zaloguj
          </SubmitButton>
        </div>
        <div class:list={columnClass} data-form="offer">
          <p class:list={labelClass}>AddOfferForm</p>
          <SubmitButton pending pendingText="Pobieram ogłoszenie…" icon={plusIcon}>
            Dodaj ofertę
          </SubmitButton>
        </div>
        <div class:list={columnClass} data-form="note">
          <p class:list={labelClass}>NoteEditor</p>
          <SubmitButton pending pendingText="Zapisuję…" icon={saveIcon}>
            Zapisz notatkę
          </SubmitButton>
        </div>
        <div class:list={columnClass} data-form="limits">
          <p class:list={labelClass}>TeamLimitsForm</p>
          <SubmitButton pending pendingText="Zapisuję…" icon={saveIcon}>
            Zapisz limity
          </SubmitButton>
        </div>
        <div class:list={columnClass} data-form="requirements">
          <p class:list={labelClass}>RequirementsEditor</p>
          <SubmitButton pending pendingText="Zapisuję…" icon={saveIcon}>
            Zapisz wymagania
          </SubmitButton>
        </div>
        <div class:list={columnClass} data-form="audit">
          <p class:list={labelClass}>AuditSettingsForm</p>
          <SubmitButton pending pendingText="Zapisywanie…" icon={saveIcon}>
            Zapisz ustawienia
          </SubmitButton>
        </div>
        <div class:list={columnClass} data-form="refetch">
          <p class:list={labelClass}>RefetchForm</p>
          <SubmitButton pending pendingText="Pobieram ogłoszenie…" icon={refetchIcon}>
            Pobierz ponownie z otodom.pl
          </SubmitButton>
        </div>
        <div class:list={columnClass} data-form="archive">
          <p class:list={labelClass}>ArchiveForm · archiwizuj</p>
          <SubmitButton pending pendingText="Archiwizuję…" icon={archiveIcon}>
            Zarchiwizuj
          </SubmitButton>
        </div>
        <div class:list={columnClass} data-form="archive-restore">
          <p class:list={labelClass}>ArchiveForm · przywróć</p>
          <SubmitButton pending pendingText="Przywracam…" icon={restoreIcon}>
            Przywróć
          </SubmitButton>
        </div>
      </div>
    </div>

    <div class:list={stateClass} data-state="archive-variants">
      <p class:list={captionClass}>Stan: warianty (tylko ArchiveForm)</p>
      <div class:list={gridClass}>
        <div class:list={columnClass} data-form="archive-restore">
          <p class:list={labelClass}>ArchiveForm · przywróć · compact</p>
          <ArchiveForm client:load offerId={noteOfferId} intent="restore" compact />
          <p class:list={noteClass}>Wariant z powiadomienia o duplikacie: przycisk o własnej szerokości.</p>
        </div>
        <div class:list={columnClass} data-form="archive-restore">
          <p class:list={labelClass}>ArchiveForm · przywróć · powrót do archiwum</p>
          <ArchiveForm client:load offerId={noteOfferId} intent="restore" returnTo="archive" />
          <p class:list={noteClass}>
            Ukryte pole <code>return=archive</code>: udane przywrócenie wraca na stronę archiwum zamiast na kartę.
          </p>
        </div>
      </div>
    </div>

    <div class:list={stateClass} data-state="refetch-overwrite">
      <p class:list={captionClass}>Stan: nadpisanie (tylko RefetchForm)</p>
      <div class:list={gridClass}>
        <div class:list={columnClass} data-form="refetch">
          <p class:list={labelClass}>RefetchForm</p>
          <RefetchForm client:load offerId={noteOfferId} acceptLost="price,rent" />
          <p class:list={noteClass}>
            Świadome nadpisanie po zatrzymaniu na utraconych polach: ukryte pole <code>accept_lost</code> odsyła tokeny
            pól, które członek zobaczył. Ostrzeżenie z listą pól renderuje karta — <code>/dev/offer-card</code>.
          </p>
        </div>
        <div class:list={columnClass} data-form="refetch">
          <p class:list={labelClass}>RefetchForm · compact</p>
          <RefetchForm client:load offerId={noteOfferId} compact />
          <p class:list={noteClass}>Wariant z powiadomienia o duplikacie: przycisk o własnej szerokości.</p>
        </div>
      </div>
    </div>

    <div class:list={stateClass} data-state="delete">
      <p class:list={captionClass}>Stan: usuwanie (DeleteOfferForm, NoteEditor)</p>
      <p class:list={noteClass}>
        Dialog potwierdzenia jest modalny, więc żadna sekcja nie otwiera go sama. Otwiera go przycisk albo adres:{" "}
        <a class="text-link underline" href="?open=delete-offer#usuwanie-stany">
          ?open=delete-offer
        </a>
        ,{" "}
        <a class="text-link underline" href="?open=delete-offer-pending#usuwanie-stany">
          ?open=delete-offer-pending
        </a>{" "}
        (stan wysyłki, nic nie wysyła) i{" "}
        <a class="text-link underline" href="?open=delete-note#usuwanie-stany">
          ?open=delete-note
        </a>
        .
      </p>
      <div id="usuwanie-stany" class:list={gridClass}>
        <div class:list={columnClass} data-form="delete-offer">
          <p class:list={labelClass}>DeleteOfferForm · default</p>
          <DeleteOfferForm client:load offerId={noteOfferId} defaultOpen={openDialog === "delete-offer"} />
          <p class:list={noteClass}>Przycisk otwiera dialog; dopiero potwierdzenie wysyła formularz.</p>
        </div>
        <div class:list={columnClass} data-form="delete-offer">
          <p class:list={labelClass}>DeleteOfferForm · error</p>
          <DeleteOfferForm client:load offerId={noteOfferId} serverError={DELETE_FAILED} />
        </div>
        <div class:list={columnClass} data-form="delete-offer">
          <p class:list={labelClass}>DeleteOfferForm · loading</p>
          <DeleteOfferForm
            client:load
            offerId={noteOfferId}
            preview="pending"
            defaultOpen={openDialog === "delete-offer-pending"}
          />
          <p class:list={noteClass}>
            Dialog w stanie wysyłki: „Usuwam…”, „Anuluj” wyłączony. Ten egzemplarz niczego nie wysyła.
          </p>
        </div>
        <div class:list={columnClass} data-form="delete-offer">
          <p class:list={labelClass}>DeleteOfferForm · compact · powrót do archiwum</p>
          <DeleteOfferForm client:load offerId={noteOfferId} returnTo="archive" compact />
          <p class:list={noteClass}>
            Wariant z wiersza archiwum: mniejszy przycisk i ukryte pole <code>return=archive</code>.
          </p>
        </div>
        <div class:list={columnClass} data-form="note">
          <p class:list={labelClass}>NoteEditor · podgląd z „Usuń”</p>
          <NoteEditor
            client:load
            offerId={noteOfferId}
            note={savedNote}
            deleteDialogOpen={openDialog === "delete-note"}
          />
        </div>
        <div class:list={columnClass} data-form="note">
          <p class:list={labelClass}>NoteEditor · nieudane usunięcie</p>
          <NoteEditor client:load offerId={noteOfferId} note={savedNote} deleteError={NOTE_DELETE_FAILED} />
          <p class:list={noteClass}>Błąd usunięcia stoi nad notatką i nie otwiera trybu edycji.</p>
        </div>
      </div>
    </div>
  </AppLayout>
) : (
  <AppLayout title="Nie znaleziono — Vetpad">
    <p class="text-muted-foreground">Nie znaleziono.</p>
  </AppLayout>
)}
