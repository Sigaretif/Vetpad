---
import AppLayout from "@/layouts/AppLayout.astro";
import SignInForm from "@/components/auth/SignInForm";
import AddOfferForm from "@/components/offers/AddOfferForm";
import NoteEditor from "@/components/offers/NoteEditor";
import TeamLimitsForm from "@/components/criteria/TeamLimitsForm";
import RequirementsEditor from "@/components/criteria/RequirementsEditor";
import { Button } from "@/components/ui/button";
import { FormField } from "@/components/form/FormField";
import { PasswordToggle } from "@/components/form/PasswordToggle";
import { SubmitButton } from "@/components/form/SubmitButton";
import { ServerError } from "@/components/form/ServerError";
import { TextareaField } from "@/components/form/TextareaField";
import { NOTE_BLANK, NOTE_FIELDS, NOTE_FIELD_LABELS, NOTE_MAX_LENGTH } from "@/lib/notes";
import { REQUIREMENTS_BLANK, REQUIREMENTS_MAX_LENGTH } from "@/lib/criteria";
import { fullLimits } from "@/pages/dev/_criteria-fixtures";
import {
  Banknote,
  CircleAlert,
  Eraser,
  Mail,
  Lock,
  LogIn,
  Link as LinkIcon,
  MapPin,
  Plus,
  Ruler,
  Save,
} from "lucide-react";
import { createElement } from "react";

// Visual gate for the shared form composites: every named state of SignInForm, AddOfferForm,
// NoteEditor, TeamLimitsForm and RequirementsEditor at once, in `astro dev` only. Anywhere else
// (a production build, `npm run preview`) it answers 404 — `scripts/smoke.mjs` checks that on the
// production preview. The status is set on
// Astro.response, not returned, because a top-level `return` crashes
// @typescript-eslint/no-misused-promises. Pattern: `src/pages/dev/offer-card.astro`.
const isDev = import.meta.env.DEV;
if (!isDev) {
  Astro.response.status = 404;
}

// Composites rendered server-side (no client:*) never call onChange; this satisfies the prop.
const noop = () => undefined;

// Astro's own template syntax has no JSX-expression runtime, so a React element built for a prop
// (an icon, a `PasswordToggle`) is created with `createElement`, not with a nested `<Tag />`
// literal inside `{}` — that compiles, but the resulting page silently renders as an empty body.
const mailIcon = createElement(Mail, { className: "size-4" });
const lockIcon = createElement(Lock, { className: "size-4" });
const linkIcon = createElement(LinkIcon, { className: "size-4" });
const logInIcon = createElement(LogIn, { className: "size-4" });
const plusIcon = createElement(Plus, { className: "size-4" });
const saveIcon = createElement(Save, { className: "size-4" });
const cityIcon = createElement(MapPin, { className: "size-4" });
const priceIcon = createElement(Banknote, { className: "size-4" });
const areaIcon = createElement(Ruler, { className: "size-4" });
const eraserIcon = createElement(Eraser);

// The limits form's fields as TeamLimitsForm lays them out, for the composite-only states.
const limitFields = [
  { name: "city", label: "Miasto", placeholder: "np. Warszawa", icon: cityIcon },
  { name: "price_min", label: "Cena od (zł)", placeholder: "np. 600 000", icon: priceIcon, inputMode: "numeric" },
  { name: "price_max", label: "Cena do (zł)", placeholder: "np. 900 000", icon: priceIcon, inputMode: "numeric" },
  { name: "area_min", label: "Minimalny metraż (m²)", placeholder: "np. 45", icon: areaIcon, inputMode: "decimal" },
] as const;
// A reversed price range: the one limits error that belongs to two fields, reported on „Cena od".
const reversedRange: Record<(typeof limitFields)[number]["name"], string> = {
  city: "Warszawa",
  price_min: "950 000",
  price_max: "600 000",
  area_min: "45",
};

// The note editor posts for an offer; this fixture offer does not exist, so a save here fails.
const noteOfferId = "00000000-0000-4000-8000-000000000001";
const hiddenPasswordToggle = createElement(PasswordToggle, { visible: false, onToggle: noop });

const stateClass = "border-border flex flex-col gap-6 border-t pt-6";
const captionClass = "text-muted-foreground font-mono text-xs tracking-wide uppercase";
const gridClass = "grid gap-8 sm:grid-cols-2 lg:grid-cols-3";
const columnClass = "flex flex-col gap-4";
const labelClass = "text-foreground text-sm font-medium";
const noteClass = "text-muted-foreground text-sm";
---

{isDev ? (
  <AppLayout title="Formularze — stany — Vetpad">
    <p class="text-muted-foreground text-sm">
      Strona testowa (tylko <code>astro dev</code>): <code>SignInForm</code>, <code>AddOfferForm</code>,{" "}
      <code>NoteEditor</code>, <code>TeamLimitsForm</code> i <code>RequirementsEditor</code> w każdym nazwanym stanie,
      złożonym z tych samych kompozytów (<code>src/components/form/</code>), których używają formularze w produkcji.
      Zmiana wyglądu formularza przechodzi przez zrzut tej strony.
    </p>

    <div class:list={stateClass} data-state="default">
      <p class:list={captionClass}>Stan: default</p>
      <div class:list={gridClass}>
        <div class:list={columnClass} data-form="signin">
          <p class:list={labelClass}>SignInForm</p>
          <SignInForm client:load />
        </div>
        <div class:list={columnClass} data-form="offer">
          <p class:list={labelClass}>AddOfferForm</p>
          <AddOfferForm client:load />
        </div>
        <div class:list={columnClass} data-form="note">
          <p class:list={labelClass}>NoteEditor</p>
          <NoteEditor client:load offerId={noteOfferId} note={null} />
        </div>
        <div class:list={columnClass} data-form="limits">
          <p class:list={labelClass}>TeamLimitsForm</p>
          <TeamLimitsForm client:load limits={fullLimits} />
        </div>
        <div class:list={columnClass} data-form="requirements">
          <p class:list={labelClass}>RequirementsEditor</p>
          <RequirementsEditor client:load own={null} />
        </div>
      </div>
    </div>

    <div class:list={stateClass} data-state="hover">
      <p class:list={captionClass}>Stan: hover</p>
      <div class:list={gridClass}>
        <div class:list={columnClass} data-form="signin">
          <p class:list={labelClass}>SignInForm</p>
          <p class:list={noteClass}>
            Przycisk „Zaloguj”: zrzut <code>forms-hover-button</code> wymusza <code>:hover</code> (CDP{" "}
            <code>CSS.forcePseudoState</code>) na ten sam przycisk w stanie „default” powyżej.
          </p>
          <p class:list={noteClass}>
            Pole: nie dotyczy — <code>Input</code> nie ma stanu hover, a pole sygnalizuje interakcję fokusem.
          </p>
        </div>
        <div class:list={columnClass} data-form="offer">
          <p class:list={labelClass}>AddOfferForm</p>
          <p class:list={noteClass}>
            Przycisk „Dodaj ofertę”: ten sam <code>SubmitButton</code>/<code>Button</code>, więc pokryty zrzutem obok.
          </p>
          <p class:list={noteClass}>Pole: nie dotyczy (jak obok).</p>
        </div>
        <div class:list={columnClass} data-form="note">
          <p class:list={labelClass}>NoteEditor</p>
          <p class:list={noteClass}>
            Przycisk „Zapisz notatkę” w stanie „default” powyżej: zrzut <code>forms-hover-note-submit</code> wymusza{" "}
            <code>:hover</code>.
          </p>
          <p class:list={noteClass}>
            Pole: nie dotyczy — <code>Textarea</code>, jak <code>Input</code>, nie ma stanu hover.
          </p>
        </div>
        <div class:list={columnClass} data-form="limits">
          <p class:list={labelClass}>TeamLimitsForm</p>
          <p class:list={noteClass}>
            „Zapisz limity” to ten sam <code>SubmitButton</code> co „Zaloguj”; „Wyczyść limity” to <code>Button</code> w
            wariancie <code>outline</code>, jak „Edytuj” notatki (zrzut <code>gate-hover-note-edit</code>). Pola: nie
            dotyczy (jak obok).
          </p>
        </div>
        <div class:list={columnClass} data-form="requirements">
          <p class:list={labelClass}>RequirementsEditor</p>
          <p class:list={noteClass}>
            Przycisk „Zapisz wymagania” w stanie „default” powyżej: zrzut <code>forms-hover-requirements-submit</code>{" "}
            wymusza <code>:hover</code>. Pole: nie dotyczy (jak obok).
          </p>
        </div>
      </div>
    </div>

    <div class:list={stateClass} data-state="focus">
      <p class:list={captionClass}>Stan: focus</p>
      <div class:list={gridClass}>
        <div class:list={columnClass} data-form="signin">
          <p class:list={labelClass}>SignInForm</p>
          <p class:list={noteClass}>
            Pole e-mail, przełącznik hasła i przycisk „Zaloguj” w stanie „default” powyżej, prawdziwymi naciśnięciami
            Tab (zrzuty <code>forms-focus-field</code>, <code>forms-focus-toggle</code>, <code>forms-focus-button</code>
            ). Pole z błędem: zrzut <code>forms-focus-field-error</code> celuje w pole e-mail w stanie „error” poniżej.
          </p>
        </div>
        <div class:list={columnClass} data-form="offer">
          <p class:list={labelClass}>AddOfferForm</p>
          <p class:list={noteClass}>
            Pole adresu i przycisk „Dodaj ofertę”: te same <code>FormField</code>/<code>SubmitButton</code>, co zrzuty
            obok.
          </p>
        </div>
        <div class:list={columnClass} data-form="note">
          <p class:list={labelClass}>NoteEditor</p>
          <p class:list={noteClass}>
            Pole „Zalety” w stanie „default” powyżej, prawdziwymi naciśnięciami Tab (zrzut{" "}
            <code>forms-focus-note-field</code>). <code>Textarea</code> ma ten sam pierścień fokusu co{" "}
            <code>Input</code> (<code>focus-visible:ring-ring/50</code>, a z błędem <code>ring-destructive/70</code>),
            przycisk to ten sam <code>SubmitButton</code>.
          </p>
        </div>
        <div class:list={columnClass} data-form="limits">
          <p class:list={labelClass}>TeamLimitsForm</p>
          <p class:list={noteClass}>
            Pole „Miasto” w stanie „default” powyżej, prawdziwymi naciśnięciami Tab (zrzut{" "}
            <code>forms-focus-limits-field</code>). Pozostałe pola to ten sam <code>FormField</code>, przyciski to{" "}
            <code>SubmitButton</code> i <code>Button</code>.
          </p>
        </div>
        <div class:list={columnClass} data-form="requirements">
          <p class:list={labelClass}>RequirementsEditor</p>
          <p class:list={noteClass}>
            Pole wymagań: ten sam <code>TextareaField</code> co „Zalety” notatki (zrzut{" "}
            <code>forms-focus-note-field</code>). „Edytuj” w podglądzie: zrzut na <code>/dev/criteria</code>.
          </p>
        </div>
      </div>
    </div>

    <div class:list={stateClass} data-state="disabled">
      <p class:list={captionClass}>Stan: disabled</p>
      <div class:list={gridClass}>
        <div class:list={columnClass} data-form="signin">
          <p class:list={labelClass}>SignInForm</p>
          <p class:list={noteClass}>
            Przycisk: ten sam render co „loading” poniżej — <code>SubmitButton</code> blokuje się tylko w trakcie
            wysyłki, a osobny <code>disabled</code> byłby propsem tylko dla testów.
          </p>
          <p class:list={noteClass}>
            Pole: nie dotyczy — nigdy nie jest blokowane, bo POST jest już wysłany, a strona się przeładuje.
          </p>
        </div>
        <div class:list={columnClass} data-form="offer">
          <p class:list={labelClass}>AddOfferForm</p>
          <p class:list={noteClass}>Jak obok.</p>
        </div>
        <div class:list={columnClass} data-form="note">
          <p class:list={labelClass}>NoteEditor</p>
          <SubmitButton pending pendingText="Zapisuję…" icon={saveIcon}>
            Zapisz notatkę
          </SubmitButton>
          <p class:list={noteClass}>
            Przycisk zablokowany tylko w trakcie wysyłki (ten sam render co „loading”). Pola: nie dotyczy, jak obok.
          </p>
        </div>
        <div class:list={columnClass} data-form="limits">
          <p class:list={labelClass}>TeamLimitsForm</p>
          <SubmitButton pending pendingText="Zapisuję…" icon={saveIcon}>
            Zapisz limity
          </SubmitButton>
          <Button type="button" variant="outline" disabled>
            {eraserIcon}
            Wyczyść limity
          </Button>
          <p class:list={noteClass}>
            W trakcie wysyłki oba przyciski są zablokowane, żeby zapis i wyczyszczenie nie poszły naraz. Pola: nie
            dotyczy, jak obok.
          </p>
        </div>
        <div class:list={columnClass} data-form="requirements">
          <p class:list={labelClass}>RequirementsEditor</p>
          <SubmitButton pending pendingText="Zapisuję…" icon={saveIcon}>
            Zapisz wymagania
          </SubmitButton>
          <Button type="button" variant="ghost" disabled>
            Anuluj
          </Button>
          <p class:list={noteClass}>
            „Anuluj” (tylko przy edycji zapisanych wymagań) blokuje się razem z przyciskiem zapisu. Pole: nie dotyczy.
          </p>
        </div>
      </div>
    </div>

    <div class:list={stateClass} data-state="error">
      <p class:list={captionClass}>Stan: error</p>
      <p class:list={noteClass}>
        Kompozyty: błąd pola i <code>ServerError</code>. Cały formularz z <code>serverError</code> jest na zrzutach{" "}
        <code>views-signin-error</code> i <code>views-dashboard-error</code> — drugi egzemplarz formularza na tej
        stronie zdublowałby identyfikatory pól.
      </p>
      <div class:list={gridClass}>
        <div class:list={columnClass} data-form="signin">
          <p class:list={labelClass}>SignInForm</p>
          <FormField
            id="error-email"
            placeholder="ty@przyklad.pl"
            type="email"
            label="E-mail"
            value="nie-adres"
            onChange={noop}
            error="Podaj poprawny adres e-mail"
            icon={mailIcon}
          />
          <ServerError message="Nieprawidłowy e-mail lub hasło." />
        </div>
        <div class:list={columnClass} data-form="offer">
          <p class:list={labelClass}>AddOfferForm</p>
          <FormField
            id="error-url"
            placeholder="https://www.otodom.pl/pl/oferta/…"
            type="url"
            label="Adres ogłoszenia"
            value="otodom oferta 123"
            onChange={noop}
            error="To nie wygląda na poprawny adres URL."
            icon={linkIcon}
          />
          <ServerError message="Vetpad obsługuje wyłącznie ogłoszenia z otodom.pl." />
        </div>
        <div class:list={columnClass} data-form="note">
          <p class:list={labelClass}>NoteEditor</p>
          {NOTE_FIELDS.map((field) => (
            <TextareaField
              id={`error-note-${field}`}
              name={field}
              label={NOTE_FIELD_LABELS[field]}
              value=""
              onChange={noop}
              maxLength={NOTE_MAX_LENGTH}
              invalid
              describedBy="error-note-message"
            />
          ))}
          <p id="error-note-message" class="text-destructive flex items-center gap-1 text-xs">
            <CircleAlert className="size-3 shrink-0" />
            {NOTE_BLANK}
          </p>
          <ServerError message="Nie udało się zapisać notatki. Spróbuj ponownie." />
        </div>
        <div class:list={columnClass} data-form="limits">
          <p class:list={labelClass}>TeamLimitsForm</p>
          {limitFields.map((field) => (
            <FormField
              id={`error-limits-${field.name}`}
              name={field.name}
              label={field.label}
              inputMode={"inputMode" in field ? field.inputMode : undefined}
              placeholder={field.placeholder}
              value={reversedRange[field.name]}
              onChange={noop}
              error={field.name === "price_min" ? "Cena od nie może być wyższa niż cena do." : undefined}
              icon={field.icon}
            />
          ))}
          <ServerError message="Nie udało się zapisać limitów. Spróbuj ponownie." />
        </div>
        <div class:list={columnClass} data-form="requirements">
          <p class:list={labelClass}>RequirementsEditor</p>
          <TextareaField
            id="error-requirements-body"
            name="body"
            label="Wymagania dodatkowe"
            value=""
            onChange={noop}
            maxLength={REQUIREMENTS_MAX_LENGTH}
            rows={6}
            invalid
            describedBy="error-requirements-message"
          />
          <p id="error-requirements-message" class="text-destructive flex items-center gap-1 text-xs">
            <CircleAlert className="size-3 shrink-0" />
            {REQUIREMENTS_BLANK}
          </p>
          <ServerError message="Nie udało się zapisać wymagań. Spróbuj ponownie." />
        </div>
      </div>
    </div>

    <div class:list={stateClass} data-state="empty">
      <p class:list={captionClass}>Stan: empty</p>
      <div class:list={gridClass}>
        <div class:list={columnClass} data-form="signin">
          <p class:list={labelClass}>SignInForm</p>
          <FormField
            id="empty-email"
            placeholder="ty@przyklad.pl"
            type="email"
            label="E-mail"
            value=""
            onChange={noop}
            error="Podaj adres e-mail"
            icon={mailIcon}
          />
          <FormField
            id="empty-password"
            placeholder="Twoje hasło"
            type="password"
            label="Hasło"
            value=""
            onChange={noop}
            error="Podaj hasło"
            icon={lockIcon}
            endContent={hiddenPasswordToggle}
          />
        </div>
        <div class:list={columnClass} data-form="offer">
          <p class:list={labelClass}>AddOfferForm</p>
          <FormField
            id="empty-url"
            placeholder="https://www.otodom.pl/pl/oferta/…"
            type="url"
            label="Adres ogłoszenia"
            value=""
            onChange={noop}
            error="Wklej adres ogłoszenia z otodom.pl"
            icon={linkIcon}
          />
        </div>
        <div class:list={columnClass} data-form="note">
          <p class:list={labelClass}>NoteEditor</p>
          {NOTE_FIELDS.map((field) => (
            <TextareaField
              id={`empty-note-${field}`}
              name={field}
              label={NOTE_FIELD_LABELS[field]}
              value=""
              onChange={noop}
              maxLength={NOTE_MAX_LENGTH}
            />
          ))}
        </div>
        <div class:list={columnClass} data-form="limits">
          <p class:list={labelClass}>TeamLimitsForm</p>
          {limitFields.map((field) => (
            <FormField
              id={`empty-limits-${field.name}`}
              name={field.name}
              label={field.label}
              inputMode={"inputMode" in field ? field.inputMode : undefined}
              placeholder={field.placeholder}
              value=""
              onChange={noop}
              icon={field.icon}
            />
          ))}
          <p class:list={noteClass}>Puste pole to brak limitu, nie błąd — formularz bez limitów zapisuje się.</p>
        </div>
        <div class:list={columnClass} data-form="requirements">
          <p class:list={labelClass}>RequirementsEditor</p>
          <TextareaField
            id="empty-requirements-body"
            name="body"
            label="Wymagania dodatkowe"
            value=""
            onChange={noop}
            maxLength={REQUIREMENTS_MAX_LENGTH}
            rows={6}
          />
        </div>
      </div>
    </div>

    <div class:list={stateClass} data-state="loading">
      <p class:list={captionClass}>Stan: loading</p>
      <div class:list={gridClass}>
        <div class:list={columnClass} data-form="signin">
          <p class:list={labelClass}>SignInForm</p>
          <SubmitButton pending pendingText="Loguję…" icon={logInIcon}>
            Zaloguj
          </SubmitButton>
        </div>
        <div class:list={columnClass} data-form="offer">
          <p class:list={labelClass}>AddOfferForm</p>
          <SubmitButton pending pendingText="Pobieram ogłoszenie…" icon={plusIcon}>
            Dodaj ofertę
          </SubmitButton>
        </div>
        <div class:list={columnClass} data-form="note">
          <p class:list={labelClass}>NoteEditor</p>
          <SubmitButton pending pendingText="Zapisuję…" icon={saveIcon}>
            Zapisz notatkę
          </SubmitButton>
        </div>
        <div class:list={columnClass} data-form="limits">
          <p class:list={labelClass}>TeamLimitsForm</p>
          <SubmitButton pending pendingText="Zapisuję…" icon={saveIcon}>
            Zapisz limity
          </SubmitButton>
        </div>
        <div class:list={columnClass} data-form="requirements">
          <p class:list={labelClass}>RequirementsEditor</p>
          <SubmitButton pending pendingText="Zapisuję…" icon={saveIcon}>
            Zapisz wymagania
          </SubmitButton>
        </div>
      </div>
    </div>
  </AppLayout>
) : (
  <AppLayout title="Nie znaleziono — Vetpad">
    <p class="text-muted-foreground">Nie znaleziono.</p>
  </AppLayout>
)}
