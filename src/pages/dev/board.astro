---
import AppLayout from "@/layouts/AppLayout.astro";
import BoardSort from "@/components/offers/BoardSort.astro";
import OfferArchive from "@/components/offers/OfferArchive.astro";
import OfferArchiveItem from "@/components/offers/OfferArchiveItem.astro";
import OfferBoard from "@/components/offers/OfferBoard.astro";
import OfferBoardItem from "@/components/offers/OfferBoardItem.astro";
import RecentlyArchived from "@/components/offers/RecentlyArchived.astro";
import { parseBoardSort, type BoardSort as BoardSortValue } from "@/lib/offer-board";
import {
  archivedEntryByDeleted,
  archivedEntryByUnknown,
  archivedEntryLongTitle,
  archivedEntryUnsafeImages,
  archivedEntryUnstated,
  archiveWithoutRecent,
  archiveWithRecent,
  areaBelowOffer,
  boardLimits,
  emptyArchive,
  failedArchive,
  failedAudits,
  failedFreshness,
  failedLimits,
  fullOffer,
  fullOfferFresh,
  fullOfferFreshnessUnknown,
  fullOfferStale,
  lodzLimits,
  longCityLimits,
  longTitleOffer,
  manyBreachesOffer,
  mixedFreshness,
  noAudits,
  noFreshness,
  noLimits,
  outsideCityOffer,
  priceAboveOffer,
  priceBelowOffer,
  singleImageOffer,
  someAudits,
  streetOnlyOffer,
  threeAudits,
  unknownOffer,
  unsafeImagesOffer,
  withinLimitsOffer,
} from "@/pages/dev/_offer-fixtures";

// Visual gate for the offer board on /dashboard: every named state at once, from fixtures, in
// `astro dev` only. Anywhere else (a production build, `npm run preview`) it answers 404 —
// `scripts/smoke.mjs` checks that on the production preview. The status is set on
// Astro.response, not returned, because a top-level `return` crashes
// @typescript-eslint/no-misused-promises. Pattern: `src/pages/dev/offer-card.astro`.
const isDev = import.meta.env.DEV;
if (!isDev) {
  Astro.response.status = 404;
}

// The sort /dashboard reads when the URL carries none.
const defaultSort = parseBoardSort(new URLSearchParams());
const priceAsc: BoardSortValue = { key: "price", dir: "asc" };
const areaDesc: BoardSortValue = { key: "area", dir: "desc" };

// Single rows, in the same <ul>/<li> markup OfferBoard gives a row in production. The rows that
// predate the team's limits render with no limit set, as before; the rest name the limits they
// are compared with. The same goes for the audit: a row without `audits` is compared with an index
// that holds no result, and the last two name the freshness of the result they have.
const BOARD_LIMITS = "limity: Warszawa, 600 000–850 000 zł, od 60 m²";
const rows = [
  {
    state: "row-unknown",
    caption: "Wiersz: wszystko nieznane (placeholder zamiast miniatury)",
    offer: unknownOffer,
    limits: noLimits,
  },
  {
    state: "row-unsafe-images",
    caption: "Wiersz: filtr miniatur (http: i javascript: odrzucone)",
    offer: unsafeImagesOffer,
    limits: noLimits,
  },
  { state: "row-long-title", caption: "Wiersz: długi tytuł bez spacji", offer: longTitleOffer, limits: noLimits },
  {
    state: "row-street-only",
    caption: "Wiersz: tylko ulica, bez etykiety lokalizacji",
    offer: streetOnlyOffer,
    limits: noLimits,
  },
  {
    state: "row-breach-city",
    caption: `Wiersz: inne miasto (${BOARD_LIMITS})`,
    offer: outsideCityOffer,
    limits: boardLimits,
  },
  {
    state: "row-breach-price-above",
    caption: `Wiersz: cena powyżej limitu (${BOARD_LIMITS})`,
    offer: priceAboveOffer,
    limits: boardLimits,
  },
  {
    state: "row-breach-price-below",
    caption: `Wiersz: cena poniżej limitu (${BOARD_LIMITS})`,
    offer: priceBelowOffer,
    limits: boardLimits,
  },
  {
    state: "row-breach-area-below",
    caption: `Wiersz: metraż poniżej limitu (${BOARD_LIMITS})`,
    offer: areaBelowOffer,
    limits: boardLimits,
  },
  {
    state: "row-breach-many",
    caption: `Wiersz: trzy złamane limity naraz (${BOARD_LIMITS})`,
    offer: manyBreachesOffer,
    limits: boardLimits,
  },
  {
    state: "row-breach-long-city",
    caption: "Wiersz: inne miasto, limit miasta o długości 100 znaków bez spacji",
    offer: outsideCityOffer,
    limits: longCityLimits,
  },
  {
    state: "row-unknown-with-limits",
    caption: `Wiersz: cena, metraż i lokalizacja nieznane — bez znacznika (${BOARD_LIMITS})`,
    offer: unknownOffer,
    limits: boardLimits,
  },
  {
    state: "row-within-limits",
    caption: "Wiersz: w limitach — „Łódź” przy limicie „lodz”, cena i metraż równe limitom (850 000 zł, 60 m²)",
    offer: withinLimitsOffer,
    limits: lodzLimits,
  },
  {
    state: "row-audit-stale",
    caption: "Wiersz: audyt nieaktualny — „Audyt nieaktualny”",
    offer: fullOffer,
    limits: noLimits,
    audits: someAudits,
    freshness: fullOfferStale,
  },
  {
    state: "row-audit-freshness-unknown",
    caption: "Wiersz: audyt, którego aktualności nie udało się ustalić — nigdy „Audytowano”",
    offer: fullOffer,
    limits: noLimits,
    audits: someAudits,
    freshness: fullOfferFreshnessUnknown,
  },
];

// The section under the board on /dashboard, in every state of the archive read.
const recentSections = [
  {
    state: "recent-some",
    caption: "Ostatnio zarchiwizowane: dwie z ostatnich 7 dni, licznik „Archiwum (4)” liczy wszystkie",
    result: archiveWithRecent,
  },
  {
    state: "recent-none",
    caption: "Ostatnio zarchiwizowane: nic z ostatnich 7 dni, w archiwum dwie oferty",
    result: archiveWithoutRecent,
  },
  { state: "recent-empty", caption: "Ostatnio zarchiwizowane: puste archiwum", result: emptyArchive },
  {
    state: "recent-error",
    caption: "Ostatnio zarchiwizowane: błąd odczytu archiwum (link bez liczby, nigdy „nic nie zarchiwizowano”)",
    result: failedArchive,
  },
];

// The list on /offers/archive, in every state of the same read.
const archiveSections = [
  {
    state: "archive-list",
    caption: "Strona archiwum: lista (przez członka, przez Ciebie, usunięte konto, nieustalony)",
    result: archiveWithRecent,
  },
  { state: "archive-empty", caption: "Strona archiwum: puste archiwum", result: emptyArchive },
  { state: "archive-error", caption: "Strona archiwum: błąd odczytu (nigdy puste archiwum)", result: failedArchive },
];

// Single archive rows, in the same <ul>/<li> markup OfferArchive gives a row in production. The
// restore button posts for an offer that does not exist: the route answers without writing anything.
const archiveRows = [
  {
    state: "archive-row-deleted",
    caption: "Wiersz archiwum: archiwizujący z usuniętym kontem",
    entry: archivedEntryByDeleted,
  },
  {
    state: "archive-row-unknown",
    caption: "Wiersz archiwum: archiwizujący nieustalony — sama data, nigdy usunięte konto",
    entry: archivedEntryByUnknown,
  },
  {
    state: "archive-row-unsafe-images",
    caption: "Wiersz archiwum: filtr miniatur (http: i javascript: odrzucone)",
    entry: archivedEntryUnsafeImages,
  },
  {
    state: "archive-row-unstated",
    caption: "Wiersz archiwum: cena, metraż i lokalizacja niepodane (placeholder zamiast miniatury)",
    entry: archivedEntryUnstated,
  },
  {
    state: "archive-row-long-title",
    caption: "Wiersz archiwum: długi tytuł bez spacji i długi adres archiwizującego",
    entry: archivedEntryLongTitle,
  },
];

const stateClass = "border-border flex flex-col gap-6 border-t pt-6";
const captionClass = "text-muted-foreground font-mono text-xs tracking-wide uppercase";
---

{isDev ? (
  <AppLayout title="Tablica ofert — stany — Vetpad">
    <p class="text-muted-foreground text-sm">
      Strona testowa (tylko <code>astro dev</code>): tablica ofert z <code>/dashboard</code> w każdym stanie, z danych
      testowych. Hover i fokus mają własne zrzuty na sekcji „default” (<code>board-hover-row</code>,{" "}
      <code>board-focus-row</code>, <code>board-focus-sort</code>); hover na wierszu ze złamanym limitem —{" "}
      <code>board-hover-breach-row</code> na sekcji „breaches”. Sekcje „breaches” i „limits-error” mają też zrzuty
      samych siebie (<code>board-breaches</code>, <code>board-limits-error</code>), tak samo sekcje „audits” i
      „audits-error” ze znaczkiem statusu audytu (<code>board-audits</code>, <code>board-audits-error</code>). Stany
      disabled i loading: nie dotyczy — tablica nie ma wyłączanych kontrolek i nie pobiera niczego po stronie klienta.
      Znaczek statusu audytu: default („Audytowano”, „Nie audytowano”, „Audyt nieaktualny”, „Aktualności audytu nie
      udało się ustalić” — sekcje „audit-freshness” i „audit-freshness-error”) i error („Nie udało się sprawdzić
      audytu”); hover, focus, disabled, empty i loading nie dotyczą — znaczek nie jest interaktywny i nie ma własnego
      stanu ładowania. Archiwum (bez bramki wizualnej): sekcja pod tablicą w stanach „recent-some”, „recent-none”,
      „recent-empty” i „recent-error”, lista ze strony <code>/offers/archive</code> w stanach „archive-list”,
      „archive-empty” i „archive-error” oraz stany wiersza archiwum „archive-row-*” (usunięte konto, archiwizujący
      nieustalony, niebezpieczne adresy zdjęć, wartości niepodane, długi tytuł).
    </p>

    <div class:list={stateClass} data-state="default">
      <p class:list={captionClass}>Stan: default (lista, sortowanie domyślne)</p>
      <OfferBoard
        result={{ ok: true, offers: [fullOffer, singleImageOffer] }}
        limits={noLimits}
        audits={noAudits}
        freshness={noFreshness}
        sort={defaultSort}
      />
    </div>

    <div class:list={stateClass} data-state="breaches">
      <p class:list={captionClass}>Stan: oferty poza limitami ({BOARD_LIMITS})</p>
      <OfferBoard
        result={{ ok: true, offers: [fullOffer, outsideCityOffer, unknownOffer] }}
        limits={boardLimits}
        audits={noAudits}
        freshness={noFreshness}
        sort={defaultSort}
        headingId="board-heading-breaches"
      />
    </div>

    <div class:list={stateClass} data-state="limits-error">
      <p class:list={captionClass}>Stan: błąd odczytu limitów (lista ofert bez znaczników)</p>
      <OfferBoard
        result={{ ok: true, offers: [fullOffer, singleImageOffer] }}
        limits={failedLimits}
        audits={noAudits}
        freshness={noFreshness}
        sort={defaultSort}
        headingId="board-heading-limits-error"
      />
    </div>

    <div class:list={stateClass} data-state="audits">
      <p class:list={captionClass}>Stan: status audytu — „Audytowano” (pierwsza oferta) i „Nie audytowano” (druga)</p>
      <OfferBoard
        result={{ ok: true, offers: [fullOffer, singleImageOffer] }}
        limits={noLimits}
        audits={someAudits}
        freshness={fullOfferFresh}
        sort={defaultSort}
        headingId="board-heading-audits"
      />
    </div>

    <div class:list={stateClass} data-state="audit-freshness">
      <p class:list={captionClass}>
        Stan: aktualność audytu — „Audytowano” (pierwsza oferta), „Audyt nieaktualny” (druga), „Aktualności audytu nie
        udało się ustalić” (trzecia) i „Nie audytowano” (czwarta)
      </p>
      <OfferBoard
        result={{ ok: true, offers: [fullOffer, singleImageOffer, longTitleOffer, streetOnlyOffer] }}
        limits={noLimits}
        audits={threeAudits}
        freshness={mixedFreshness}
        sort={defaultSort}
        headingId="board-heading-audit-freshness"
      />
    </div>

    <div class:list={stateClass} data-state="audit-freshness-error">
      <p class:list={captionClass}>
        Stan: błąd odczytu aktualności (każdy audytowany wiersz: „Aktualności audytu nie udało się ustalić”, nigdy
        „Audytowano”; oferta bez audytu nadal „Nie audytowano”)
      </p>
      <OfferBoard
        result={{ ok: true, offers: [fullOffer, singleImageOffer, streetOnlyOffer] }}
        limits={noLimits}
        audits={threeAudits}
        freshness={failedFreshness}
        sort={defaultSort}
        headingId="board-heading-audit-freshness-error"
      />
    </div>

    <div class:list={stateClass} data-state="audits-error">
      <p class:list={captionClass}>
        Stan: błąd odczytu audytów (każdy wiersz: „Nie udało się sprawdzić audytu”, nigdy „Nie audytowano”)
      </p>
      <OfferBoard
        result={{ ok: true, offers: [fullOffer, longTitleOffer] }}
        limits={boardLimits}
        audits={failedAudits}
        freshness={failedFreshness}
        sort={defaultSort}
        headingId="board-heading-audits-error"
      />
    </div>

    <div class:list={stateClass} data-state="sort-price-asc">
      <p class:list={captionClass}>Stan: sortowanie „Cena ↑”</p>
      <BoardSort sort={priceAsc} />
    </div>

    <div class:list={stateClass} data-state="sort-area-desc">
      <p class:list={captionClass}>Stan: sortowanie „Metraż ↓”</p>
      <BoardSort sort={areaDesc} />
    </div>

    <div class:list={stateClass} data-state="empty">
      <p class:list={captionClass}>Stan: brak ofert</p>
      <OfferBoard
        result={{ ok: true, offers: [] }}
        limits={noLimits}
        audits={noAudits}
        freshness={noFreshness}
        sort={defaultSort}
        headingId="board-heading-empty"
      />
    </div>

    <div class:list={stateClass} data-state="error">
      <p class:list={captionClass}>Stan: błąd odczytu</p>
      <OfferBoard
        result={{ ok: false }}
        limits={noLimits}
        audits={noAudits}
        freshness={noFreshness}
        sort={defaultSort}
        headingId="board-heading-error"
      />
    </div>

    {rows.map((row) => (
      <div class:list={stateClass} data-state={row.state}>
        <p class:list={captionClass}>Stan: {row.caption}</p>
        <ul class="flex flex-col gap-3">
          <li>
            <OfferBoardItem
              offer={row.offer}
              limits={row.limits}
              audits={row.audits ?? noAudits}
              freshness={row.freshness ?? noFreshness}
            />
          </li>
        </ul>
      </div>
    ))}

    {recentSections.map((section) => (
      <div class:list={stateClass} data-state={section.state}>
        <p class:list={captionClass}>Stan: {section.caption}</p>
        <RecentlyArchived result={section.result} headingId={`recently-archived-heading-${section.state}`} />
      </div>
    ))}

    {archiveSections.map((section) => (
      <div class:list={stateClass} data-state={section.state}>
        <p class:list={captionClass}>Stan: {section.caption}</p>
        <OfferArchive result={section.result} headingId={`archive-heading-${section.state}`} />
      </div>
    ))}

    {archiveRows.map((row) => (
      <div class:list={stateClass} data-state={row.state}>
        <p class:list={captionClass}>Stan: {row.caption}</p>
        <ul class="flex flex-col gap-3">
          <li>
            <OfferArchiveItem entry={row.entry} />
          </li>
        </ul>
      </div>
    ))}
  </AppLayout>
) : (
  <AppLayout title="Nie znaleziono — Vetpad">
    <p class="text-muted-foreground">Nie znaleziono.</p>
  </AppLayout>
)}
