---
import AppLayout from "@/layouts/AppLayout.astro";
import CriteriaView from "@/components/criteria/CriteriaView.astro";
import type { AuditSettingsResult } from "@/lib/audit/settings";
import type { CriteriaResult } from "@/lib/criteria";
import {
  defaultAuditSettings,
  deletedSaverAuditSettings,
  deletedSaverCriteria,
  emptyCriteria,
  failedAuditSettings,
  failedCriteria,
  fullCriteria,
  longCriteria,
  longEmailAuditSettings,
  memberAuditSettings,
  partialCriteria,
  selfAuditSettings,
  unknownAuthorAuditSettings,
  unknownAuthorCriteria,
} from "@/pages/dev/_criteria-fixtures";

// Visual gate for /criteria: every named state of the view at once, from fixtures, in `astro dev`
// only. Anywhere else (a production build, `npm run preview`) it answers 404. The status is set
// on Astro.response, not returned, because a top-level `return` crashes
// @typescript-eslint/no-misused-promises. Pattern: `src/pages/dev/board.astro`.
const isDev = import.meta.env.DEV;
if (!isDev) {
  Astro.response.status = 404;
}

interface State {
  state: string;
  caption: string;
  criteria: CriteriaResult;
  auditSettings: AuditSettingsResult;
  serverError?: string;
  serverErrorFor?: "limits" | "requirements" | "audit";
  startEditing?: boolean;
}

// Each state renders the whole view; `-<state>` keeps the sections' ids unique on one page. The
// islands post to the real routes, so a save here changes the local database's criteria and its
// audit settings.
const states: State[] = [
  {
    state: "full",
    caption:
      "Pełne: wszystkie limity (zmienił członek zespołu), własne wymagania w podglądzie, dwa cudze · ustawienia audytu zmienione przez członka zespołu",
    criteria: fullCriteria,
    auditSettings: memberAuditSettings,
  },
  {
    state: "empty",
    caption:
      "Puste: bez limitów (nikt ich nie zmieniał), bez wymagań — od razu pusty formularz · ustawienia audytu domyślne, bez podpisu",
    criteria: emptyCriteria,
    auditSettings: defaultAuditSettings,
  },
  {
    state: "partial",
    caption:
      "Częściowe limity (zmieniłeś Ty) · formularz limitów z błędem serwera · bez własnych wymagań · ustawienia audytu zmienione przez Ciebie",
    criteria: partialCriteria,
    auditSettings: selfAuditSettings,
    serverError: "Nie udało się zapisać limitów. Spróbuj ponownie.",
    serverErrorFor: "limits",
  },
  {
    state: "deleted-saver",
    caption: "Limity i ustawienia audytu zmienione przez osobę z usuniętym kontem · nikt inny nie wpisał wymagań",
    criteria: deletedSaverCriteria,
    auditSettings: deletedSaverAuditSettings,
  },
  {
    state: "unknown-author",
    caption: "Autor nieustalony: limity, cudze wymagania i ustawienia audytu nie nazywają nikogo",
    criteria: unknownAuthorCriteria,
    auditSettings: unknownAuthorAuditSettings,
  },
  {
    state: "error",
    caption: "Błąd odczytu kryteriów po nieudanym zapisie: bez formularzy kryteriów · ustawienia audytu odczytane",
    criteria: failedCriteria,
    auditSettings: defaultAuditSettings,
    serverError: "Nie udało się zapisać wymagań. Spróbuj ponownie.",
    serverErrorFor: "requirements",
  },
  {
    state: "long",
    caption:
      "Długa nazwa miasta, długi adres, długie słowo i akapity · własne wymagania w edycji z błędem serwera · długi adres w podpisie ustawień audytu",
    criteria: longCriteria,
    auditSettings: longEmailAuditSettings,
    serverError: "Nie udało się zapisać wymagań. Spróbuj ponownie.",
    serverErrorFor: "requirements",
    startEditing: true,
  },
  {
    state: "audit-error",
    caption: "Ustawienia audytu: komunikat serwera nad formularzem po nieudanym zapisie",
    criteria: fullCriteria,
    auditSettings: memberAuditSettings,
    serverError: "Nie udało się zapisać ustawień audytu. Spróbuj ponownie.",
    serverErrorFor: "audit",
  },
  {
    state: "audit-read-error",
    caption: "Ustawienia audytu: nieudany odczyt po nieudanym zapisie — bez formularza i bez wartości domyślnych",
    criteria: fullCriteria,
    auditSettings: failedAuditSettings,
    serverError: "Nie udało się zapisać ustawień audytu. Spróbuj ponownie.",
    serverErrorFor: "audit",
  },
];

const stateClass = "border-border flex flex-col gap-6 border-t pt-6";
const captionClass = "text-muted-foreground font-mono text-xs tracking-wide uppercase";
---

{isDev ? (
  <AppLayout title="Kryteria — stany — Vetpad">
    <p class="text-muted-foreground text-sm">
      Strona testowa (tylko <code>astro dev</code>): widok <code>/criteria</code> w każdym stanie, z danych testowych.
      Zmiana wyglądu kryteriów przechodzi przez zrzut tej strony. Formularze są prawdziwymi wyspami — zapis stąd zmienia
      kryteria i ustawienia audytu w lokalnej bazie. Fokus i hover mają własne zrzuty na sekcji „full” (
      <code>criteria-focus-city</code>, <code>criteria-focus-requirements-edit</code>,{" "}
      <code>criteria-hover-limits-submit</code>, <code>criteria-focus-audit-model</code>,{" "}
      <code>criteria-hover-audit-submit</code>); stany disabled i loading formularzy są na <code>/dev/forms</code>.
    </p>

    {states.map((state) => (
      <div class:list={stateClass} data-state={state.state}>
        <p class:list={captionClass}>Stan: {state.caption}</p>
        <CriteriaView
          criteria={state.criteria}
          auditSettings={state.auditSettings}
          serverError={state.serverError}
          serverErrorFor={state.serverErrorFor}
          startEditing={state.startEditing}
          anchorSuffix={`-${state.state}`}
        />
      </div>
    ))}
  </AppLayout>
) : (
  <AppLayout title="Nie znaleziono — Vetpad">
    <p class="text-muted-foreground">Nie znaleziono.</p>
  </AppLayout>
)}
