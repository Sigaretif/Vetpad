---
import AppLayout from "@/layouts/AppLayout.astro";
import DuplicateNotice from "@/components/offers/DuplicateNotice.astro";
import OfferNotFound from "@/components/offers/OfferNotFound.astro";
import OfferView from "@/components/offers/OfferView.astro";
import RefetchNotice from "@/components/offers/RefetchNotice.astro";
import { buttonVariants } from "@/components/ui/button";
import { auditFreshness, currentListingFingerprint, type AuditFreshness } from "@/lib/audit/freshness";
import { loadOfferAudit, type OfferAudit } from "@/lib/audit/store";
import { isAuditAvailable } from "@/lib/config-status";
import { loadCriteriaRevision, type CriteriaRevisionResult } from "@/lib/criteria";
import { resolveSaver, type Saver } from "@/lib/members";
import { loadNotes, type OfferNotes } from "@/lib/notes";
import { createClient } from "@/lib/supabase";
import type { OfferRow } from "@/lib/otodom/types";
import { cn } from "@/lib/utils";
import { isUuid } from "@/lib/uuid";

// One client per view, for the offer, its author, its notes and its audit; `null` when Supabase is unconfigured.
const supabase = createClient(Astro.request.headers, Astro.cookies);

/**
 * The saved offer, or `null` for everything that is not one: a malformed id, unconfigured
 * Supabase (the zero-config state), a query error, or no row. Each of those is a 404, never a 500.
 */
async function loadOffer(id: string | undefined): Promise<OfferRow | null> {
  if (!id || !isUuid(id)) return null;
  if (!supabase) return null;
  try {
    const result = await supabase.from("offers").select("*").eq("id", id).maybeSingle();
    return result.error || !result.data ? null : (result.data as OfferRow);
  } catch {
    return null;
  }
}

// A frontmatter `return new Response(...)` crashes @typescript-eslint/no-misused-promises
// (top-level return has no enclosing function), so the 404 is set on Astro.response instead.
const offer = await loadOffer(Astro.params.id);
if (!offer) {
  Astro.response.status = 404;
}

// The author comes from the offer row, never from the URL: anyone can type `?duplicate=1`.
// resolveSaver never throws, so a missing `members` table or a failed read degrades the notice
// and the card's author line to the unnamed variant instead of a 500.
// Notes are read once per view, and only for an existing offer. loadNotes never throws: a failed
// read is `{ state: "error" }`, which renders the column without the editor, never a 500.
// The audit is read the same way: loadOfferAudit never throws, and a failed read is
// `{ state: "error" }`, which renders the audit section without its button. The moment of the view
// decides whether an attempt still counts as running. The module read here is the audit's store —
// never its provider, whose SDK a card render must not load.
// The criteria revision is read beside them, for the audit's freshness: loadCriteriaRevision never
// throws either, and a failed read is `{ ok: false }` — never a revision. The listing's current
// fingerprint is taken from the offer row this view already holds.
// The reads are independent and never throw, so they run side by side.
const [saver, notes, audit, revision, fingerprint]: [
  Saver,
  OfferNotes | null,
  OfferAudit | null,
  CriteriaRevisionResult,
  string | null,
] = offer
  ? await Promise.all([
      resolveSaver(supabase, offer.created_by, Astro.locals.user?.id),
      loadNotes(supabase, offer.id, Astro.locals.user?.id),
      loadOfferAudit(supabase, offer.id, Astro.locals.user?.id, new Date()),
      loadCriteriaRevision(supabase),
      currentListingFingerprint(offer),
    ])
  : [{ kind: "unknown" }, null, null, { ok: false }, null];
const duplicate = offer !== null && Astro.url.searchParams.get("duplicate") === "1";

// Whether the stored result still describes what the team sees (FR-003, FR-009). `null` when
// there is no result to judge. A revision or a fingerprint that could not be read goes in as
// `null`, and the rule decides — it never reads a side it could not compare as "nothing changed".
// Nothing here runs, re-runs or removes an audit, and nothing is written.
const freshness: AuditFreshness | null =
  audit?.state === "ok" && audit.result !== null
    ? auditFreshness(
        { criteriaRevision: audit.result.criteriaRevision, listingFingerprint: audit.result.listingFingerprint },
        { criteriaRevision: revision.ok ? revision.revision : null, listingFingerprint: fingerprint },
      )
    : null;

// Two routes redirect back to the card with `?error=`: POST /api/offer-refetch, which adds
// `&form=refetch` (`/offers/<id>?error=…&form=refetch#pobranie`), and POST /api/notes
// (`/offers/<id>?error=…#notatki`). The page cannot read the `#` fragment, so `form` tells them
// apart: with `form=refetch` the message belongs to the re-fetch block, in every other case to the
// note editor. Rendered as text, never as HTML.
const error = offer ? Astro.url.searchParams.get("error") : null;
const errorIsRefetch = Astro.url.searchParams.get("form") === "refetch";
const refetchError = errorIsRefetch ? error : null;
const noteError = errorIsRefetch ? null : error;

// What POST /api/offer-refetch leaves in the address after a fetch that went through: `lost` when
// it stopped on facts that would disappear, `refetched` when it saved. Anyone can type either by
// hand; the components that take them read them through a whitelist and render no value as it came.
const lost = offer ? Astro.url.searchParams.get("lost") : null;
const refetched = offer ? Astro.url.searchParams.get("refetched") : null;
---

<AppLayout wide={offer !== null} title={offer ? `${offer.title} — Vetpad` : "Nie znaleziono oferty — Vetpad"}>
  {duplicate && <DuplicateNotice slot="notice" saver={saver} offerId={offer.id} />}
  {refetched !== null && <RefetchNotice slot="notice" refetched={refetched} />}

  <a href="/dashboard" class:list={cn(buttonVariants({ variant: "link" }), "h-auto self-start p-0")}>
    ← Wróć do ofert
  </a>

  {offer === null || notes === null || audit === null ? (
    <OfferNotFound />
  ) : (
    <OfferView
      offer={offer}
      saver={saver}
      notes={notes}
      audit={audit}
      auditAvailable={isAuditAvailable()}
      freshness={freshness}
      noteError={noteError}
      refetchError={refetchError}
      lost={lost}
    />
  )}
</AppLayout>
